---
// Navbar.astro
---

<nav class="navbar" id="navbar">
    <div class="navbar-inner">
        <a href="/#home" class="navbar-logo-container">
            <div class="navbar-logo-icon"><div class="navbar-logo-box"><span>JN</span></div></div>
        </a>
        
        <div class="navbar-right">
            <div class="desktop-nav-links">
                <a href="/#home" data-translate="navHome">Home</a>
                <a href="/#about" data-translate="navAbout">O Mnie</a>
                <a href="/#projects" data-translate="navProjects">Projekty</a>
                <a href="/#certificates" data-translate="navCertificates">Certyfikaty</a>
            </div>
            
            <div class="nav-tools">
                <div class="theme-switcher">
                    <button class="theme-btn" id="btn-dark-theme" title="Dark Mode">
                        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                            <path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" clip-rule="evenodd"></path>
                        </svg>
                    </button>
                    <button class="theme-btn active" id="btn-light-theme" title="Light Mode">
                        <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                            <path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18.75a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-1.5a.75.75 0 0 1 .75-.75ZM5.106 17.834a.75.75 0 0 0 1.06 1.06l1.591-1.59a.75.75 0 1 0-1.06-1.061l-1.591 1.59ZM2.25 12a.75.75 0 0 1 .75-.75H5.25a.75.75 0 0 1 0 1.5H3a.75.75 0 0 1-.75-.75ZM6.166 5.106a.75.75 0 0 0-1.06 1.06l1.59 1.591a.75.75 0 1 0 1.061-1.06l-1.59-1.591Z"></path>
                        </svg>
                    </button>
                </div>
                <!-- Przełącznik języka w formie nowoczesnego suwaka -->
                <div class="lang-switch">
                    <button class="lang-btn active" data-lang="pl">PL</button>
                    <button class="lang-btn" data-lang="en">EN</button>
                </div>
            </div>
        </div>
        <button class="mobile-menu-toggle" id="mobile-menu-toggle" aria-label="Toggle menu"><span></span><span></span><span></span></button>
    </div>
</nav>

<div class="mobile-nav-menu" id="mobile-nav-menu">
    <!-- DODANE ATRYBUTY data-translate DLA WERSJI MOBILNEJ -->
    <a href="/#home" data-translate="navHome">Home</a>
    <a href="/#about" data-translate="navAbout">O Mnie</a>
    <a href="/#projects" data-translate="navProjects">Projekty</a>
    <a href="/#certificates" data-translate="navCertificates">Certyfikaty</a>
    
    <div class="theme-switcher" style="margin-top: 30px;">
        <button class="theme-btn" id="btn-dark-theme-mobile" title="Dark Mode">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path fill-rule="evenodd" d="M9.528 1.718a.75.75 0 01.162.819A8.97 8.97 0 009 6a9 9 0 009 9 8.97 8.97 0 003.463-.69.75.75 0 01.981.98 10.503 10.503 0 01-9.694 6.46c-5.799 0-10.5-4.701-10.5-10.5 0-4.368 2.667-8.112 6.46-9.694a.75.75 0 01.818.162z" clip-rule="evenodd"></path></svg>
        </button>
        <button class="theme-btn active" id="btn-light-theme-mobile" title="Light Mode">
            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg"><path d="M12 2.25a.75.75 0 0 1 .75.75v2.25a.75.75 0 0 1-1.5 0V3a.75.75 0 0 1 .75-.75ZM7.5 12a4.5 4.5 0 1 1 9 0 4.5 4.5 0 0 1-9 0ZM18.894 6.166a.75.75 0 0 0-1.06-1.06l-1.591 1.59a.75.75 0 1 0 1.06 1.061l1.591-1.59ZM21.75 12a.75.75 0 0 1-.75.75h-2.25a.75.75 0 0 1 0-1.5H21a.75.75 0 0 1 .75.75ZM17.834 18.894a.75.75 0 0 0 1.06-1.06l-1.59-1.591a.75.75 0 1 0-1.061 1.06l1.59 1.591ZM12 18.75a.75.75 0 0 1 .75.75V21a.75.75 0 0 1-1.5 0v-1.5a.75.75 0 0 1 .75-.75ZM5.106 17.834a.75.75 0 0 0 1.06 1.06l1.591-1.59a.75.75 0 1 0-1.06-1.061l-1.591 1.59ZM2.25 12a.75.75 0 0 1 .75-.75H5.25a.75.75 0 0 1 0 1.5H3a.75.75 0 0 1-.75-.75ZM6.166 5.106a.75.75 0 0 0-1.06 1.06l1.59 1.591a.75.75 0 1 0 1.061-1.06l-1.59-1.591Z"></path></svg>
        </button>
    </div>
    
    <!-- Mobilny suwak języka -->
    <div class="lang-switch" style="margin-top: 20px;">
        <button class="lang-btn active" data-lang="pl">PL</button>
        <button class="lang-btn" data-lang="en">EN</button>
    </div>
</div>

<style is:global>
    .navbar { position: fixed; top: 0; left: 0; right: 0; z-index: 1000; display: flex; align-items: center; justify-content: center; height: 70px; background: var(--bg-nav); backdrop-filter: blur(15px); -webkit-backdrop-filter: blur(15px); border-bottom: 1px solid var(--border-color); transition: transform 0.4s cubic-bezier(.77, 0, .18, 1), background-color var(--transition-speed) ease, border-color var(--transition-speed) ease; }
    .navbar.hide { transform: translateY(-100%); }
    .navbar-inner { width: 100%; max-width: 1200px; margin: 0 auto; display: flex; align-items: center; justify-content: space-between; padding: 0 32px; }
    .navbar-logo-container { position: relative; display: flex; align-items: center; gap: 12px; text-decoration: none; }
    .navbar-logo-icon { position: relative; width: 40px; height: 40px; }
    .navbar-logo-icon::before { content: ''; position: absolute; inset: 0; background: var(--cyan); opacity: 0.3; border-radius: 8px; filter: blur(6px); transition: opacity 0.3s; }
    .navbar-logo-container:hover .navbar-logo-icon::before { opacity: 0.5; }
    .navbar-logo-box { position: relative; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; border-radius: 8px; background: var(--bg-surface); border: 1px solid var(--border-color); box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1); }
    .navbar-logo-box span { font-size: 1.2rem; font-weight: 700; background: var(--text-primary); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    
    .navbar-right { display: flex; align-items: center; gap: 24px; }
    .desktop-nav-links { display: flex; gap: 24px; }
    .desktop-nav-links a { color: var(--text-secondary); text-decoration: none; font-size: 1rem; font-weight: 500; position: relative; padding: 8px 4px; transition: color 0.3s; }
    .desktop-nav-links a:hover, .desktop-nav-links a.active { color: var(--text-primary); }
    .desktop-nav-links a::after { content: ''; position: absolute; bottom: 0; left: 50%; transform: translateX(-50%); width: 0; height: 2px; background: var(--cyan); border-radius: 1px; transition: width 0.3s ease; }
    .desktop-nav-links a:hover::after, .desktop-nav-links a.active::after { width: 80%; }
    
    .nav-tools { display: flex; align-items: center; gap: 15px; border-left: 1px solid var(--border-color); padding-left: 15px;}
    .theme-switcher { display: flex; align-items: center; gap: 5px; background: var(--btn-bg); padding: 4px; border-radius: 20px; border: 1px solid var(--border-color);}
    .theme-btn { display: flex; align-items: center; justify-content: center; width: 28px; height: 28px; border-radius: 50%; cursor: pointer; color: var(--text-secondary); transition: all 0.3s; border: none; background: transparent; }
    .theme-btn:hover { color: var(--text-primary); }
    .theme-btn.active { background: var(--bg-surface); color: var(--cyan); box-shadow: 0 2px 5px rgba(0,0,0,0.1); }
    .theme-btn svg { width: 16px; height: 16px; }

    /* NOWY DESIGN PRZEŁĄCZNIKA JĘZYKÓW */
    .lang-switch { display: flex; align-items: center; gap: 4px; background: var(--btn-bg); padding: 4px; border-radius: 20px; border: 1px solid var(--border-color); }
    .lang-btn { cursor: pointer; padding: 4px 10px; transition: all 0.3s; border-radius: 16px; background: transparent; border: none; font-family: inherit; font-size: 0.9rem; font-weight: bold; color: var(--text-secondary); }
    .lang-btn:hover { color: var(--text-primary); }
    /* Wyróżniony aktywny stan (biały tekst na gradiencie) */
    .lang-btn.active { color: #ffffff !important; background: var(--line-gradient) !important; box-shadow: 0 2px 8px rgba(6, 182, 212, 0.3); }

    .mobile-menu-toggle { display: none; width: 30px; height: 22px; background: transparent; border: none; cursor: pointer; position: relative; z-index: 1001; }
    .mobile-menu-toggle span { display: block; width: 100%; height: 3px; background: var(--cyan); border-radius: 2px; position: absolute; left: 0; transition: all 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
    .mobile-menu-toggle span:nth-child(1) { top: 0; } .mobile-menu-toggle span:nth-child(2) { top: 50%; transform: translateY(-50%); } .mobile-menu-toggle span:nth-child(3) { bottom: 0; }
    body.nav-open .mobile-menu-toggle span:nth-child(1) { transform: translateY(9.5px) rotate(45deg); } body.nav-open .mobile-menu-toggle span:nth-child(2) { opacity: 0; } body.nav-open .mobile-menu-toggle span:nth-child(3) { transform: translateY(-9.5px) rotate(-45deg); }
    
    .mobile-nav-menu { display: flex; position: fixed; top: 70px; left: 0; width: 100%; height: calc(100vh - 70px); background: var(--bg-nav); backdrop-filter: blur(10px); flex-direction: column; justify-content: center; align-items: center; gap: 30px; padding-bottom: 70px; opacity: 0; transform: translateY(-20px); pointer-events: none; z-index: 999; transition: opacity 0.3s ease, transform 0.3s ease; }
    body.nav-open .mobile-nav-menu { opacity: 1; transform: translateY(0); pointer-events: auto; }
    .mobile-nav-menu a { font-size: 2rem; color: var(--text-secondary); text-decoration: none; font-weight: 700; transition: color 0.3s, transform 0.3s; }
    .mobile-nav-menu a:hover { color: var(--text-primary); transform: scale(1.05); }

    @media (max-width: 900px) {
        .navbar-right { display: none; }
        .mobile-menu-toggle { display: block; }
    }
    @media (max-width: 600px) {
        .navbar-inner { padding: 0 24px; }
    }
</style>

<script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
        // --- MOTYWY ---
        const themeBtnsDark = document.querySelectorAll('#btn-dark-theme, #btn-dark-theme-mobile');
        const themeBtnsLight = document.querySelectorAll('#btn-light-theme, #btn-light-theme-mobile');
        
        function updateThemeButtons(theme) {
            if (theme === 'dark') {
                themeBtnsDark.forEach(btn => btn.classList.add('active'));
                themeBtnsLight.forEach(btn => btn.classList.remove('active'));
            } else {
                themeBtnsLight.forEach(btn => btn.classList.add('active'));
                themeBtnsDark.forEach(btn => btn.classList.remove('active'));
            }
        }

        function updateTheme(newTheme) {
            document.documentElement.setAttribute('data-theme', newTheme);
            localStorage.setItem('theme', newTheme);
            updateThemeButtons(newTheme);
        }

        updateThemeButtons(document.documentElement.getAttribute('data-theme') || 'light');
        
        themeBtnsDark.forEach(btn => btn.addEventListener('click', () => updateTheme('dark')));
        themeBtnsLight.forEach(btn => btn.addEventListener('click', () => updateTheme('light')));

        // --- OBSŁUGA JĘZYKÓW WIZUALNA (dziala globalnie na wszystkich stronach) ---
        const langBtns = document.querySelectorAll('.lang-btn');
        function updateLangButtons(lang) {
            langBtns.forEach(btn => {
                btn.classList.toggle('active', btn.dataset.lang === lang);
            });
        }
        
        // Zsynchronizuj wygląd przycisków na start
        const currentLang = localStorage.getItem('preferredLanguage') || 'pl';
        updateLangButtons(currentLang);

        langBtns.forEach(btn => {
            btn.addEventListener('click', (e) => {
                const selectedLang = e.target.dataset.lang;
                updateLangButtons(selectedLang);
                document.body.classList.remove('nav-open'); // Automatycznie zamknij menu po kliknięciu na telefonie!
            });
        });

        // --- MENU MOBILNE WIZUALNE ---
        const mobileMenuToggle = document.getElementById("mobile-menu-toggle");
        if(mobileMenuToggle) {
            mobileMenuToggle.addEventListener("click", () => document.body.classList.toggle("nav-open"));
            document.querySelectorAll(".mobile-nav-menu a").forEach(t => t.addEventListener("click", () => document.body.classList.remove("nav-open")));
        }

        // --- UKRYWANIE PRAY SCROLLOWANIU ---
        const navbar = document.getElementById("navbar");
        let lastScroll = 0;
        function setupNavbarScroll() {
            if (window.lenis && navbar) {
                window.lenis.on('scroll', ({ scroll }) => {
                    const currentScroll = scroll;
                    if (currentScroll <= 10) {
                        navbar.classList.remove("hide");
                        lastScroll = currentScroll;
                        return;
                    }
                    if (currentScroll > lastScroll && !document.body.classList.contains("nav-open")) {
                        navbar.classList.add("hide");
                    } else if (currentScroll < lastScroll) {
                        navbar.classList.remove("hide");
                    }
                    lastScroll = currentScroll;
                });
            } else {
                setTimeout(setupNavbarScroll, 100);
            }
        }
        setupNavbarScroll();
    });
</script>