---
import BaseLayout from '../layouts/BaseLayout.astro';
import Navbar from '../components/Navbar.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout title="Portfolio | Jakub Nicpoń">
  <Navbar />

  <header id="home">
    <div class="header-flex">
      <div class="header-photo">
        <img src="/assets/ownphoto.png" class="profile-image" alt="Zdjęcie profilowe" data-translate-alt="profilePicAlt" />
      </div>
      <div class="header-content">
        <div class="welcome-text" data-translate="headerWelcome">Witaj w moim portfolio</div>
        <h1>Jakub Nicpoń</h1>
        <span class="section-underline"></span>
        <h2>
          <span class="typewriter-full-text">
             <span class="normal-text" data-translate="jobTitlePart1">Aspirujący </span>
             <span class="gradient-text" data-translate="jobTitlePart2">Analityk Danych &amp; BI Developer</span>
          </span>
        </h2>
        <p class="header-desc" data-translate="headerDesc">Łączę dane z designem, tworząc nowoczesne rozwiązania analityczne. Odkryj moje projekty!</p>
        <div class="header-btns">
          <a href="/assets/CV_Nicpon_Jakub.pdf" class="gradient__border__container primary-cta" download><span class="gradient__border__text" data-translate="btnCV">Pobierz CV</span></a>
          <a href="mailto:nicponjakub@outlook.com" class="gradient__border__container"><span class="gradient__border__text" data-translate="btnContact">Kontakt</span></a>
          <a href="https://www.linkedin.com/in/jakub-nicpoń-1a449942b/" target="_blank" class="gradient__border__container"><span class="gradient__border__text" data-translate="btnLinkedin">LinkedIn</span></a>
        </div>
      </div>
    </div>
    <a href="#about" class="scroll-indicator" title="Przewiń dalej" data-translate-title="scrollHint"></a>
  </header>

  <div class="stylish-header-wrapper reveal-element" id="about">
    <span class="header-big-number">01</span>
    <div class="stylish-header-content">
        <h2 class="stylish-title" data-translate="skillsTitle">Technologie i Narzędzia</h2>
        <div class="stylish-line"></div>
    </div>
  </div>

  <section class="about-section">
    <div class="container">
      <div class="skills-container">
        <div class="skills-grid">
          <div class="skill-card reveal-element">
            <div class="skill-icon"><img src="https://img.icons8.com/?size=100&id=117561&format=png" alt="Excel"></div>
            <h4 class="skill-name">Excel</h4>
            <p class="skill-description" data-translate="skillExcel">Power Query, VBA, zaawansowane formuły, interaktywne dashboardy.</p>
          </div>
          <div class="skill-card reveal-element">
            <div class="skill-icon"><img src="https://img.icons8.com/?size=100&id=Ny0t2MYrJ70p&format=png" alt="Power BI"></div>
            <h4 class="skill-name">Power BI</h4>
            <p class="skill-description" data-translate="skillPowerBI">Modelowanie danych, DAX, projektowanie klarownych wizualizacji.</p>
          </div>
          <div class="skill-card reveal-element">
            <div class="skill-icon"><img src="https://img.icons8.com/?size=100&id=J6KcaRLsTgpZ&format=png" alt="SQL"></div>
            <h4 class="skill-name">SQL</h4>
            <p class="skill-description" data-translate="skillSQL">CTE, podzapytania, funkcje okna, złączenia, agregacje, widoki</p>
          </div>
          <div class="skill-card reveal-element">
            <div class="skill-icon"><img src="https://img.icons8.com/?size=100&id=13441&format=png" alt="Python"></div>
            <h4 class="skill-name">Python</h4>
            <p class="skill-description" data-translate="skillPython">Pandas, NumPy, czyszczenie i transformacja danych.</p>
          </div>
          <div class="skill-card reveal-element">
            <div class="skill-icon"><img src="https://www.r-project.org/logo/Rlogo.svg" alt="R"></div>
            <h4 class="skill-name">R Project</h4>
            <p class="skill-description" data-translate="skillR">W trakcie nauki. ⏳</p>
          </div>
          <div class="skill-card reveal-element">
            <div class="skill-icon"><img src="https://zonalogo.com/assets/databricks-logo-png-svg.webp?asset=4825&w=240" alt="Databricks"></div>
            <h4 class="skill-name">Databricks</h4>
            <p class="skill-description" data-translate="skillDatabricks">W trakcie nauki. ⏳</p>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="stylish-header-wrapper reveal-element">
    <span class="header-big-number">02</span>
    <div class="stylish-header-content">
        <h2 class="stylish-title" data-translate="aboutTitle">O Mnie</h2>
        <div class="stylish-line"></div>
        <p class="stylish-subtitle" data-translate="aboutSubtitle">
            Moja podróż w świat danych zaczęła się od fascynacji tym, jak surowe liczby mogą opowiadać historie i napędzać strategiczne decyzje.
        </p>
    </div>
  </div>

  <section class="about-section">
    <div class="container">
      <div class="about-grid">
        <div class="about-bio reveal-element">
          <h3 data-translate="aboutPassionTitle">Moja Pasja & Droga</h3>
          <p data-translate="aboutPassionText">
            Inżynier logistyki i student analityki finansowej z pasją do odkrywania wartości w danych. Łączę ścisłe, procesowe myślenie z wiedzą finansową, przekładając złożone zbiory danych na czytelne dashboardy, wnikliwe raporty i realne rekomendacje biznesowe.<br><br>Traktuję pracę z danymi jak wyzwanie intelektualne - im bardziej skomplikowany problem, tym większa satysfakcja z odnalezienia ukrytych zależności. Stale rozwijam swój warsztat technologiczny oraz statystyczny.
          </p>
          
          <div class="horizontal-timeline">
              <div class="ht-line"></div>
              <div class="ht-item">
                  <div class="ht-dot"></div>
                  <div class="ht-date">2021-2025</div>
                  <div class="ht-title" data-translate="edu1Title">Logistyka inżynierska<br>(Uniwersytet Ekonomiczny w Katowicach)</div>
              </div>
              <div class="ht-item">
                  <div class="ht-dot"></div>
                  <div class="ht-date" data-translate="edu2Date">2025-obecnie</div>
                  <div class="ht-title" data-translate="edu2Title">Analityka Finansowa<br>(Uniwersytet Ekonomiczny w Katowicach)</div>
              </div>
          </div>
        </div>

        <div class="about-certificates reveal-element">
            <div class="cert-verify-card">
                <img src="/assets/Coursera GOOGLE ANALYTICS.png" alt="Google Analytics Certificate">
                <a href="https://coursera.org/verify/professional-cert/Q5UMS9IDRWZY" target="_blank" class="verify-btn" data-translate="btnVerify">Zweryfikuj</a>
            </div>
            <div class="cert-verify-card">
                <img src="/assets/Coursera YALE.png" alt="Yale Certificate">
                <a href="https://coursera.org/verify/6U3PH5Y75BZ7" target="_blank" class="verify-btn" data-translate="btnVerify">Zweryfikuj</a>
            </div>
        </div>
      </div>
    </div>
  </section>

  <div class="stylish-header-wrapper reveal-element" id="projects">
    <span class="header-big-number">03</span>
    <div class="stylish-header-content">
        <h2 class="stylish-title" data-translate="projectsTitle">Projekty</h2>
        <div class="stylish-line"></div>
    </div>
  </div>

