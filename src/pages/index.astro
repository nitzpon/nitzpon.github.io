  <style>
    /* STYLE SPECYFICZNE DLA STRONY GŁÓWNEJ (INDEX) */
    header { min-height: 100vh; background: transparent; color: var(--text-primary); display: flex; align-items: center; justify-content: center; position: relative; overflow: hidden; transition: filter 0.3s ease, opacity 0.3s ease; padding-top: 70px; }
    
    .header-flex {
        display: flex;
        flex-direction: row;
        align-items: stretch;
        justify-content: center;
        width: 100%;
        max-width: 1100px;
        min-height: 600px;
        background: var(--header-card-bg);
        backdrop-filter: blur(20px);
        border-radius: 24px;
        border: 1px solid var(--border-color);
        box-shadow: var(--header-shadow);
        position: relative;
        z-index: 1;
        margin: 40px auto 0 auto;
        overflow: hidden;
    }
    
    .header-photo { flex: 1 1 45%; position: relative; overflow: hidden; }
    .header-photo .profile-image { width: 100%; height: 100%; object-fit: cover; min-height: 400px; }
    .header-photo::after { content: ''; position: absolute; top: 0; right: 0; bottom: 0; width: 100%; pointer-events: none; }
    :global([data-theme="dark"]) .header-photo::after { background: linear-gradient(90deg, transparent 40%, rgba(14, 23, 38, 0.85) 100%); }
    
    .header-content { flex: 1 1 55%; display: flex; flex-direction: column; justify-content: center; padding: 60px 40px; background: transparent; z-index: 2; }
    .header-content .welcome-text { font-size: 1.5rem; font-weight: 700; color: var(--cyan); margin-bottom: 15px; text-transform: uppercase; letter-spacing: 2px; animation: fadeInDown 2s ease-out; }
    .header-content h1 { font-size: 3.8rem; font-weight: 800; margin-bottom: 10px; line-height: 1.1; color: var(--text-primary); text-shadow: var(--title-shadow); animation: fadeInDown 2s ease-out; }
    .header-content h2 { font-size: 1.4rem; font-weight: 500; letter-spacing: 1px; color: var(--text-secondary); display: flex; align-items: center; margin-bottom: 25px; animation: fadeInUp 2s ease-out 0.3s both; }
    .typewriter-full-text { display: inline-block; overflow: hidden; white-space: nowrap; border-right: 2px solid var(--cyan); animation: typing 4s steps(40, end) forwards, blink-caret .75s step-end infinite; width: 0; font-weight: 700; }
    .normal-text { color: var(--text-primary); }
    .gradient-text { background: var(--line-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; animation: liquidText 4s linear infinite; }
    .header-content .section-underline { margin: 15px 0 25px 0; width: 60px; height: 4px; border-radius: 2px; background: var(--line-gradient); animation: fadeInDown 1.2s 0.2s both; }
