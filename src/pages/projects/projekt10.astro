<span class="py-fun">print</span>(<span class="py-str">f'Suma wartości brakujących po czyszczeniu \n &#123;df.isna().sum()&#125;'</span>)
<span class="py-fun">print</span>(<span class="py-str">'===================================='</span>)
<span class="py-obj">df</span>.<span class="py-fun">to_csv</span>(<span class="py-str">"clean_financial_transactions.csv"</span>, index=<span class="py-key">False</span>)
<span class="py-fun">print</span>(<span class="py-str">'Plik clean_financial_transactions.csv został pomyślnie zapisany'</span>)


<span class="py-fun">print</span>(<span class="py-str">'===================================='</span>)
<span class="py-fun">print</span>(<span class="py-str">'Agregacja danych i proste podsumowanie danych per inwestor'</span>.<span class="py-fun">center</span>(<span class="py-num">50</span>, <span class="py-str">'-'</span>).<span class="py-fun">upper</span>())

<span class="py-com"># 1. Agregacja kluczowych wskaźników per inwestor</span>
