                    const key = el.dataset.translate;
                    if (translations[lang] && translations[lang][key]) { 
                        el.innerHTML = translations[lang][key]; 
                    }
                });

                if(translations[lang]) {
                    const chalBody = document.getElementById('challengesContentBody');
                    if (chalBody) chalBody.innerHTML = translations[lang].challengesContent;
                    
                    const methBody = document.getElementById('methodologyContentBody');
                    if (methBody) methBody.innerHTML = translations[lang].methodologyContent;
                    
                    const datBody = document.getElementById('dataContentBody');
                    if (datBody) datBody.innerHTML = translations[lang].dataContent;
                }
            };

