        const setLocalLanguage = (lang) => {
            document.documentElement.lang = lang;
            document.querySelectorAll('[data-translate]').forEach(el => {
                const key = el.dataset.translate;
                if (translations[lang] && translations[lang][key]) { 
                    el.innerHTML = translations[lang][key]; 
                }
            });
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.lang === lang);
            });
            localStorage.setItem('preferredLanguage', lang);
        };

        document.querySelectorAll('.lang-btn').forEach(button => {
            button.addEventListener('click', () => {
                setLocalLanguage(button.dataset.lang);
            });
        });

        document.addEventListener('DOMContentLoaded', () => {
            const preferredLanguage = localStorage.getItem('preferredLanguage') || 'pl';
            setLocalLanguage(preferredLanguage);

            // Lightbox
            const lightbox = document.getElementById('lightbox');
            const lightboxImg = lightbox.querySelector('.lightbox-image');
            const lightboxClose = lightbox.querySelector('.lightbox-close');
            const allImages = document.querySelectorAll('.result-img');

            const openLightbox = (imgSrc) => {
                lightboxImg.src = imgSrc;
                lightbox.classList.add('open');
                if (window.lenis) window.lenis.stop();
            };

            const closeLightbox = () => {
                lightbox.classList.remove('open');
                if (window.lenis) window.lenis.start();
            };

            allImages.forEach(img => {
                img.parentElement.addEventListener('click', () => {
                    openLightbox(img.src);
                });
            });

            lightboxClose.addEventListener('click', closeLightbox);
            lightbox.addEventListener('click', (e) => {
                if (e.target === lightbox) closeLightbox();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape' && lightbox.classList.contains('open')) closeLightbox();
            });

            // Glow effect for city cards
            document.querySelectorAll('.city-card').forEach(card => {
                card.addEventListener('mousemove', (e) => {
                    const rect = card.getBoundingClientRect();
                    card.style.setProperty('--mouse-x', `${e.clientX - rect.left}px`);
                    card.style.setProperty('--mouse-y', `${e.clientY - rect.top}px`);
                });
            });
        });
