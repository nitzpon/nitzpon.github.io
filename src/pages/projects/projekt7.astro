---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="SQL Case Study: Coffee Shops Analysis | Portfolio Jakub Nicpoń">
    <Navbar />

    <main class="container">
        <header class="project-hero">
            <h1 data-translate="heroTitle">Coffee Shops Market Analysis</h1>
            <div class="section-underline centered-underline"></div>
            <p data-translate="heroDesc">
                Analiza danych rynkowych kawiarni w Indiach. Wykorzystałem SQL do zbadania rentowności produktów, 
                nasycenia rynku oraz dynamiki przychodów, co pozwoliło wyłonić kluczowe miasta pod przyszłe inwestycje.
            </p>
            <div class="nav-buttons">
                <a href="#step-0" class="btn-nav btn-primary" data-translate="btnSql">Zobacz zapytania SQL</a>
                <a href="#final-analysis" class="btn-nav btn-secondary" data-translate="btnAnalysis">Analiza Końcowa</a>
                <a href="/assets/Coffeehouse.rar" download class="btn-nav btn-outline" data-translate="btnDownload">Pobierz pliki CSV</a>
            </div>
        </header>

        <section class="audit-section">
            <h2 style="text-align: center;" data-translate="auditTitle">Struktura tabel</h2>
            <div class="section-underline centered-underline"></div>
            <div class="audit-grid">
                <div class="audit-card">
                    <h4>Tabela: City</h4>
                    <div class="result-container"><img src="/assets/001.png" class="result-img" alt="Struktura tabeli City"></div>
                </div>
                <div class="audit-card">
                    <h4>Tabela: Customers</h4>
                    <div class="result-container"><img src="/assets/002.png" class="result-img" alt="Struktura tabeli Customers"></div>
                </div>
                <div class="audit-card">
                    <h4>Tabela: Products</h4>
                    <div class="result-container"><img src="/assets/003.png" class="result-img" alt="Struktura tabeli Products"></div>
                </div>
                <div class="audit-card">
                    <h4>Tabela: Sales</h4>
                    <div class="result-container"><img src="/assets/004.png" class="result-img" alt="Struktura tabeli Sales"></div>
                </div>
            </div>
        </section>

        <div class="sql-step" id="step-0">
            <h3 data-translate="step0Title">00. Stworzenie bazy i struktury pod import danych</h3>
            <span class="step-description" data-translate="step0Desc">-- Co obliczam i po co: Przygotowuję fundament pod projekt, czyli tworzę bazę i tabele z relacjami, żeby wszystko było na swoim miejscu przed importem danych.</span>
            <div class="code-container">
<pre><code><span class="sql-com">-- Krok 1: Utworzenie bazy danych oraz ustawienie jej jako aktywnej</span>
<span class="sql-key">CREATE DATABASE</span> coffee_shops_project;
<span class="sql-key">USE</span> coffee_shops_project;

<span class="sql-com">-- Krok 2: Przygotowanie schematu bazy danych</span>
<span class="sql-key">DROP TABLE IF EXISTS</span> city;
<span class="sql-key">CREATE TABLE</span> city (
    city_id <span class="sql-key">int PRIMARY KEY</span>,
    city_name <span class="sql-key">varchar</span>(30),
    population <span class="sql-key">int</span>,
    estimated_rent <span class="sql-key">float</span>,
    city_rank <span class="sql-key">int</span>
);

<span class="sql-key">CREATE TABLE</span> customers (
    customer_id <span class="sql-key">int PRIMARY KEY</span>,
    customer_name <span class="sql-key">varchar</span>(30),
    city_id <span class="sql-key">int</span>,
    <span class="sql-key">CONSTRAINT</span> fk_city <span class="sql-key">FOREIGN KEY</span> (city_id) <span class="sql-key">REFERENCES</span> city (city_id)
);

<span class="sql-key">CREATE TABLE</span> products (
    product_id <span class="sql-key">int PRIMARY KEY</span>,
    product_name <span class="sql-key">varchar</span>(30),
    price <span class="sql-key">float</span>
);

<span class="sql-key">CREATE TABLE</span> sales (
    sale_id <span class="sql-key">int PRIMARY KEY</span>,
    product_id <span class="sql-key">int</span>,
    customer_id <span class="sql-key">int</span>,
    sale_date <span class="sql-key">date</span>,
    total <span class="sql-key">float</span>,
    rating <span class="sql-key">int</span>,
    <span class="sql-key">CONSTRAINT</span> fk_products <span class="sql-key">FOREIGN KEY</span> (product_id) <span class="sql-key">REFERENCES</span> products (product_id),
    <span class="sql-key">CONSTRAINT</span> fk_customers <span class="sql-key">FOREIGN KEY</span> (customer_id) <span class="sql-key">REFERENCES</span> customers (customer_id)
);</code></pre>
            </div>
            <div class="result-container"><img src="/assets/model.png" class="result-img" alt="Model bazy danych"></div>
        </div>

        <div class="sql-step" id="step-1">
            <h3 data-translate="step1Title">01. Szacowana liczba konsumentów</h3>
            <span class="step-description" data-translate="step1Desc">-- Ilu potencjalnych kawoszy mieszka w każdym mieście, zakładając, że co piąta osoba pije kawę. (wg. Google - 20% populacji Indii pije kawę)</span>
            <div class="code-container">
<pre><code><span class="sql-key">SELECT</span>
    city_name,
    <span class="sql-fun">ROUND</span>(population * 0.2 / 1000000, 2) consumers_in_mln,
    city_rank
<span class="sql-key">FROM</span> city
<span class="sql-key">ORDER BY</span> population <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_1.png" class="result-img" alt="Wynik zapytania 1"></div>
        </div>

        <div class="sql-step" id="step-2">
            <h3 data-translate="step2Title">02. Całkowity przychód ze sprzedaży</h3>
            <span class="step-description" data-translate="step2Desc">-- Suma przychodów z ostatniego kwartału 2023 roku, żeby zobaczyć, które miasta najlepiej zarabiały pod koniec roku.</span>
            <div class="code-container">
<pre><code><span class="sql-key">WITH</span> Q4_2023_revenue <span class="sql-key">AS</span> (
    <span class="sql-key">SELECT</span>
        ci.city_name,
        <span class="sql-fun">SUM</span>(s.total) revenue_by_city
    <span class="sql-key">FROM</span> sales s
    <span class="sql-key">JOIN</span> customers cu <span class="sql-key">ON</span> s.customer_id = cu.customer_id
    <span class="sql-key">JOIN</span> city ci <span class="sql-key">ON</span> cu.city_id = ci.city_id
    <span class="sql-key">WHERE</span>
        <span class="sql-fun">EXTRACT</span>(YEAR <span class="sql-key">FROM</span> s.sale_date) = 2023
        <span class="sql-key">AND</span>
        <span class="sql-fun">EXTRACT</span>(QUARTER <span class="sql-key">FROM</span> s.sale_date) = 4
    <span class="sql-key">GROUP BY</span> ci.city_name
)
<span class="sql-key">SELECT</span>
    city_name,
    revenue_by_city,
    <span class="sql-fun">SUM</span>(revenue_by_city) <span class="sql-fun">OVER</span>() total_revenue,
    <span class="sql-fun">CONCAT</span>(<span class="sql-fun">ROUND</span>(revenue_by_city/<span class="sql-fun">SUM</span>(revenue_by_city) <span class="sql-fun">OVER</span>() * 100, 2), '%') revenue_part
<span class="sql-key">FROM</span> Q4_2023_revenue
<span class="sql-key">ORDER BY</span> revenue_by_city <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_2.png" class="result-img" alt="Wynik zapytania 2"></div>
        </div>

        <div class="sql-step" id="step-3">
            <h3 data-translate="step3Title">03. Wolumen sprzedaży produktów</h3>
            <span class="step-description" data-translate="step3Desc">-- Sprawdzenie, co ludzie najchętniej kupują i które produkty przynoszą najwięcej gotówki.</span>
            <div class="code-container">
<pre><code><span class="sql-key">SELECT</span>
    p.product_name,
    <span class="sql-fun">COUNT</span>(s.product_id) units_sold,
    <span class="sql-fun">SUM</span>(s.total) revenue
<span class="sql-key">FROM</span> sales s
<span class="sql-key">LEFT JOIN</span> products p <span class="sql-key">ON</span> s.product_id = p.product_id
<span class="sql-key">GROUP BY</span> p.product_name
<span class="sql-key">ORDER BY</span> units_sold <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_3.png" class="result-img" alt="Wynik zapytania 3"></div>
        </div>

        <div class="sql-step" id="step-4">
            <h3 data-translate="step4Title">04. Średnia kwota koszyka wg miast</h3>
            <span class="step-description" data-translate="step4Desc">-- Sprawdzenie, ile przeciętnie klient zostawia pieniędzy podczas jednej wizyty w zależności od miasta.</span>
            <div class="code-container">
<pre><code><span class="sql-key">SELECT</span>
    ci.city_name city,
    <span class="sql-fun">ROUND</span>(<span class="sql-fun">AVG</span>(s.total), 2) avg_revenue
<span class="sql-key">FROM</span> sales s
<span class="sql-key">JOIN</span> customers cu <span class="sql-key">ON</span> s.customer_id = cu.customer_id
<span class="sql-key">JOIN</span> city ci <span class="sql-key">ON</span> cu.city_id = ci.city_id
<span class="sql-key">GROUP BY</span> city
<span class="sql-key">ORDER BY</span> avg_revenue <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_4.png" class="result-img" alt="Wynik zapytania 4"></div>
        </div>

        <div class="sql-step" id="step-5">
            <h3 data-translate="step5Title">05. Średni przychód na klienta</h3>
            <span class="step-description" data-translate="step5Desc">-- Jaka kwota średnio wyciągana jest od jednego, konkretnego klienta – gdzie mamy najbardziej lojalnych fanów.</span>
            <div class="code-container">
<pre><code><span class="sql-key">SELECT</span>
    ci.city_name city,
    <span class="sql-fun">SUM</span>(s.total) total_revenue,
    <span class="sql-fun">COUNT</span>(<span class="sql-key">DISTINCT</span> cu.customer_id) unique_customers,
    <span class="sql-fun">ROUND</span>(<span class="sql-fun">SUM</span>(s.total) / <span class="sql-fun">COUNT</span>(<span class="sql-key">DISTINCT</span> cu.customer_id), 2) avg_revenue_per_customer
<span class="sql-key">FROM</span> sales s
<span class="sql-key">JOIN</span> customers cu <span class="sql-key">ON</span> s.customer_id = cu.customer_id
<span class="sql-key">JOIN</span> city ci <span class="sql-key">ON</span> cu.city_id = ci.city_id
<span class="sql-key">GROUP BY</span> ci.city_name
<span class="sql-key">ORDER BY</span> avg_revenue_per_customer <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_5.png" class="result-img" alt="Wynik zapytania 5"></div>
        </div>

        <div class="sql-step" id="step-6">
            <h3 data-translate="step6Title">06. Nasycenie rynku (Penetration Rate)</h3>
            <span class="step-description" data-translate="step6Desc">-- Porównanie liczby realnych klientów do wszystkich potencjalnych kawoszy w mieście, żeby zobaczyć, ile rynku potencjalnie jest "spenetrowane".</span>
            <div class="code-container">
<pre><code><span class="sql-key">WITH</span> city_details <span class="sql-key">AS</span> (
    <span class="sql-key">SELECT</span> city_name city, <span class="sql-fun">ROUND</span>((population * 0.2) / 1000000, 2) consumers_in_mln <span class="sql-key">FROM</span> city),
customer_details <span class="sql-key">AS</span> (
    <span class="sql-key">SELECT</span> ci.city_name city, <span class="sql-fun">COUNT</span>(<span class="sql-key">DISTINCT</span> cu.customer_id) unique_customers
    <span class="sql-key">FROM</span> sales s <span class="sql-key">JOIN</span> customers cu <span class="sql-key">ON</span> s.customer_id = cu.customer_id
    <span class="sql-key">JOIN</span> city ci <span class="sql-key">ON</span> cu.city_id = ci.city_id <span class="sql-key">GROUP BY</span> city)
<span class="sql-key">SELECT</span>
    cud.city, cid.consumers_in_mln, cud.unique_customers,
    <span class="sql-fun">ROUND</span>((cud.unique_customers / (cid.consumers_in_mln * 1000000)) * 100, 5) penetration_rate_pct
<span class="sql-key">FROM</span> city_details cid <span class="sql-key">JOIN</span> customer_details cud <span class="sql-key">ON</span> cid.city = cud.city
<span class="sql-key">ORDER BY</span> penetration_rate_pct <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_6.png" class="result-img" alt="Wynik zapytania 6"></div>
        </div>

        <div class="sql-step" id="step-7">
            <h3 data-translate="step7Title">07. Top 3 Produkty w każdym mieście</h3>
            <span class="step-description" data-translate="step7Desc">-- Ranking najlepiej sprzedających się rzeczy dla każdego miasta z osobna.</span>
            <div class="code-container">
<pre><code><span class="sql-key">WITH</span> top_selling_products_by_city <span class="sql-key">AS</span> (
    <span class="sql-key">SELECT</span>
        ci.city_name city, p.product_name product, <span class="sql-fun">COUNT</span>(s.product_id) sales_count,
        <span class="sql-fun">DENSE_RANK</span>() <span class="sql-fun">OVER</span> (<span class="sql-fun">PARTITION BY</span> ci.city_name <span class="sql-key">ORDER BY</span> <span class="sql-fun">COUNT</span>(s.product_id) <span class="sql-key">DESC</span>) ranking
    <span class="sql-key">FROM</span> sales s <span class="sql-key">JOIN</span> products p <span class="sql-key">ON</span> s.product_id = p.product_id
    <span class="sql-key">JOIN</span> customers cu <span class="sql-key">ON</span> s.customer_id = cu.customer_id
    <span class="sql-key">JOIN</span> city ci <span class="sql-key">ON</span> cu.city_id = ci.city_id
    <span class="sql-key">GROUP BY</span> ci.city_name, p.product_name)
<span class="sql-key">SELECT</span> city, product, sales_count, ranking
<span class="sql-key">FROM</span> top_selling_products_by_city <span class="sql-key">WHERE</span> ranking <span class="sql-key">BETWEEN</span> 1 <span class="sql-key">AND</span> 3;</code></pre>
            </div>
        </div>

        <div class="sql-step" id="step-8">
            <h3 data-translate="step8Title">08. Produkty nigdy niesprzedane</h3>
            <span class="step-description" data-translate="step8Desc">-- Towary oraz ich ilość, których nikt w danym mieście jeszcze nie kupił, żeby orientacyjnie wiedzieć, gdzie w najmniejszym stopniu widnieje popyt na oferowany towar.</span>
            <div class="code-container">
<pre><code><span class="sql-key">WITH</span> all_combinations <span class="sql-key">AS</span> (
    <span class="sql-key">SELECT</span> ci.city_id, ci.city_name, p.product_id, p.product_name
    <span class="sql-key">FROM</span> city ci <span class="sql-key">CROSS JOIN</span> products p),
sold_in_cities <span class="sql-key">AS</span> (
    <span class="sql-key">SELECT DISTINCT</span> cu.city_id, s.product_id
    <span class="sql-key">FROM</span> sales s <span class="sql-key">JOIN</span> customers cu <span class="sql-key">ON</span> s.customer_id = cu.customer_id)
<span class="sql-key">SELECT</span>
    ac.city_name, <span class="sql-fun">COUNT</span>(ac.product_id) unsold_products_count,
    <span class="sql-fun">GROUP_CONCAT</span>(ac.product_name <span class="sql-key">SEPARATOR</span> ', ') Unsold_products
<span class="sql-key">FROM</span> all_combinations ac <span class="sql-key">LEFT JOIN</span> sold_in_cities sic 
    <span class="sql-key">ON</span> ac.city_id = sic.city_id <span class="sql-key">AND</span> ac.product_id = sic.product_id
<span class="sql-key">WHERE</span> sic.product_id <span class="sql-key">IS NULL</span> <span class="sql-key">GROUP BY</span> ac.city_name;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_8.png" class="result-img" alt="Wynik zapytania 8"></div>
        </div>

        <div class="sql-step" id="step-9">
            <h3 data-translate="step9Title">09. Procent populacji jako klienci</h3>
            <span class="step-description" data-translate="step9Desc">-- Wyliczenie, jaki ułamek całego miasta stanowią klienci, żeby ocenić skalę biznesu.</span>
            <div class="code-container">
<pre><code><span class="sql-key">SELECT</span>
    ci.city_name city, ci.population population,
    <span class="sql-fun">COUNT</span>(<span class="sql-key">DISTINCT</span> c.customer_id) unique_customers,
    <span class="sql-fun">CAST</span>(<span class="sql-fun">COUNT</span>(<span class="sql-key">DISTINCT</span> c.customer_id) / <span class="sql-fun">NULLIF</span>(ci.population, 0) * 100 <span class="sql-key">AS DECIMAL</span> (10,4)) unique_percent
<span class="sql-key">FROM</span> city ci <span class="sql-key">LEFT JOIN</span> customers c <span class="sql-key">ON</span> ci.city_id = c.city_id
<span class="sql-key">JOIN</span> sales s <span class="sql-key">ON</span> c.customer_id = s.customer_id
<span class="sql-key">GROUP BY</span> ci.city_name, ci.population <span class="sql-key">ORDER BY</span> unique_percent <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_9.png" class="result-img" alt="Wynik zapytania 9"></div>
        </div>

        <div class="sql-step" id="step-10">
            <h3 data-translate="step10Title">10. Przychód na unikalnego i ogólnego klienta</h3>
            <span class="step-description" data-translate="step10Desc">-- Zestawienie przychodów z liczbą klientów, żeby wiedzieć, gdzie zarabiamy najwięcej na pojedynczym zamówieniu.</span>
            <div class="code-container">
<pre><code><span class="sql-key">SELECT</span>
    ci.city_name city,
    <span class="sql-fun">COUNT</span>(s.customer_id) total_customers,
    <span class="sql-fun">COUNT</span>(<span class="sql-key">DISTINCT</span> s.customer_id) unique_customers,
    <span class="sql-fun">SUM</span>(s.total) sales_revenue,
    <span class="sql-fun">COALESCE</span>(<span class="sql-fun">ROUND</span>(<span class="sql-fun">SUM</span>(s.total)/<span class="sql-fun">NULLIF</span>(<span class="sql-fun">COUNT</span>(c.customer_id), 0), 2), 0) sales_per_customer
<span class="sql-key">FROM</span> city ci <span class="sql-key">LEFT JOIN</span> customers c <span class="sql-key">ON</span> ci.city_id = c.city_id
<span class="sql-key">LEFT JOIN</span> sales s <span class="sql-key">ON</span> c.customer_id = s.customer_id
<span class="sql-key">GROUP BY</span> ci.city_name <span class="sql-key">ORDER BY</span> sales_per_customer <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_10.png" class="result-img" alt="Wynik zapytania 10"></div>
        </div>

        <div class="sql-step" id="step-11">
            <h3 data-translate="step11Title">11. Stosunek sprzedaży do czynszu</h3>
            <span class="step-description" data-translate="step11Desc">-- Sprawdzenie, czy zarobki w miastach pokrywają wysokie czynsze i czy stacjonarne lokale mają tam sens.</span>
            <div class="code-container">
<pre><code><span class="sql-key">SELECT</span>
    ci.city_name,
    <span class="sql-fun">ROUND</span>(<span class="sql-fun">SUM</span>(s.total) / ci.estimated_rent, 2) sales_to_rent_ratio,
    <span class="sql-fun">ROUND</span>(ci.estimated_rent / <span class="sql-fun">NULLIF</span>(<span class="sql-fun">COUNT</span>(<span class="sql-key">DISTINCT</span> s.customer_id), 0), 2) avg_rent_per_customer
<span class="sql-key">FROM</span> sales s <span class="sql-key">JOIN</span> customers c <span class="sql-key">ON</span> s.customer_id = c.customer_id
<span class="sql-key">JOIN</span> city ci <span class="sql-key">ON</span> c.city_id = ci.city_id
<span class="sql-key">GROUP BY</span> ci.city_name, ci.estimated_rent <span class="sql-key">ORDER BY</span> sales_to_rent_ratio <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_11.png" class="result-img" alt="Wynik zapytania 11"></div>
        </div>

        <div class="sql-step" id="step-12">
            <h3 data-translate="step12Title">12. Dynamika wzrostu przychodów (QoQ)</h3>
            <span class="step-description" data-translate="step12Desc">-- Porównanie wyników sprzedaży między Q3 a Q4 2023 r. w celu wyznaczenia tempa wzrostu w poszczególnych miastach.</span>
            <div class="code-container">
<pre><code><span class="sql-key">WITH</span> quarterly_sales <span class="sql-key">AS</span> (
    <span class="sql-key">SELECT</span> ci.city_name, <span class="sql-fun">EXTRACT</span>(QUARTER <span class="sql-key">FROM</span> s.sale_date) quarter, <span class="sql-fun">SUM</span>(s.total) revenue
    <span class="sql-key">FROM</span> sales s <span class="sql-key">JOIN</span> customers cu <span class="sql-key">ON</span> s.customer_id = cu.customer_id
    <span class="sql-key">JOIN</span> city ci <span class="sql-key">ON</span> cu.city_id = ci.city_id <span class="sql-key">WHERE</span> <span class="sql-fun">EXTRACT</span>(YEAR <span class="sql-key">FROM</span> s.sale_date) = 2023
    <span class="sql-key">GROUP BY</span> ci.city_name, quarter)
<span class="sql-key">SELECT</span>
    curr.city_name, prev.revenue revenue_q3, curr.revenue revenue_q4,
    <span class="sql-fun">ROUND</span>(((curr.revenue - prev.revenue) / prev.revenue) * 100, 2) qoq_growth_pct
<span class="sql-key">FROM</span> quarterly_sales curr <span class="sql-key">JOIN</span> quarterly_sales prev 
    <span class="sql-key">ON</span> curr.city_name = prev.city_name <span class="sql-key">AND</span> curr.quarter = 4 <span class="sql-key">AND</span> prev.quarter = 3
<span class="sql-key">ORDER BY</span> qoq_growth_pct <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_12.png" class="result-img" alt="Wynik zapytania 12"></div>
        </div>

        <div class="sql-step" id="step-13">
            <h3 data-translate="step13Title">13. Udział segmentu Premium</h3>
            <span class="step-description" data-translate="step13Desc">-- Sprawdzenie, jaki procent sprzedaży stanowią produkty droższe niż średnia kwota, które miasta preferują droższy asortyment.</span>
            <div class="code-container">
<pre><code><span class="sql-key">SELECT</span>
    ci.city_name,
    <span class="sql-fun">COUNT</span>(<span class="sql-key">CASE WHEN</span> p.price > (<span class="sql-key">SELECT</span> <span class="sql-fun">AVG</span>(price) <span class="sql-key">FROM</span> products) <span class="sql-key">THEN</span> 1 <span class="sql-key">END</span>) premium_units_sold,
    <span class="sql-fun">ROUND</span>(<span class="sql-fun">COUNT</span>(<span class="sql-key">CASE WHEN</span> p.price > (<span class="sql-key">SELECT</span> <span class="sql-fun">AVG</span>(price) <span class="sql-key">FROM</span> products) <span class="sql-key">THEN</span> 1 <span class="sql-key">END</span>) / <span class="sql-fun">COUNT</span>(s.sale_id) * 100, 2) premium_share_pct
<span class="sql-key">FROM</span> sales s <span class="sql-key">JOIN</span> products p <span class="sql-key">ON</span> s.product_id = p.product_id
<span class="sql-key">JOIN</span> customers cu <span class="sql-key">ON</span> s.customer_id = cu.customer_id
<span class="sql-key">JOIN</span> city ci <span class="sql-key">ON</span> cu.city_id = ci.city_id
<span class="sql-key">GROUP BY</span> ci.city_name <span class="sql-key">ORDER BY</span> premium_share_pct <span class="sql-key">DESC</span>;</code></pre>
            </div>
            <div class="result-container"><img src="/assets/res_13.png" class="result-img" alt="Wynik zapytania 13"></div>
        </div>

