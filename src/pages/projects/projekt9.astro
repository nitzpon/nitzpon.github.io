    YouTube_Likes <span class="sql-key">NVARCHAR</span>(100),
    TikTok_Posts <span class="sql-key">NVARCHAR</span>(100),
    TikTok_Likes <span class="sql-key">NVARCHAR</span>(100),
    TikTok_Views <span class="sql-key">NVARCHAR</span>(100),
