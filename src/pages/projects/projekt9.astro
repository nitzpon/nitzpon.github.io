<span class="dax-var">VAR</span> AVG_Spotify <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])
<span class="dax-var">RETURN</span>
