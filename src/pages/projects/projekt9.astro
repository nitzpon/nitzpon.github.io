---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Projekt: TikTok Spotify Correlation Analysis | Portfolio Jakub Nicpoń">
  <Navbar />

  <main class="container">
    <header class="project-hero">
      <h1 data-translate="heroTitle">Projekt: TikTok Spotify Correlation Analysis</h1>
      <div class="section-underline centered-underline"></div>
      <p data-translate="heroDesc">
        Analiza wpływu popularności utworów na TikToku na ich odtworzenia na Spotify. Projekt łączy inżynierię danych w SQL Server (czyszczenie, kategoryzacja, tworzenie widoków) z zaawansowanym modelowaniem w Power BI (miary DAX, Drill-Through, badanie korelacji i testy statystyczne T-Value).
      </p>
      <div class="nav-buttons">
        <a href="#project-details-card" class="btn-nav btn-primary" onclick="showSection('sectionSQL')" data-translate="btnSql">SQL: Inżynieria Danych</a>
        <a href="#project-details-card" class="btn-nav btn-secondary" onclick="showSection('sectionDAX')" data-translate="btnDax">DAX: Miary & Model</a>
        <a href="#project-details-card" class="btn-nav btn-outline" onclick="showSection('sectionInsights')" data-translate="btnInsights">Analiza & Wnioski</a>
      </div>
      
      <div class="hero-image-wrapper">
        <div class="project-gallery-grid">
          <img src="/assets/TikTokSpotify1.png" alt="Dashboard Main Page" class="project-image" loading="eager" />
          <img src="/assets/TikTokSpotify2.png" alt="Drill-Through Page" class="project-image" loading="lazy" />
          <img src="/assets/TikTokSpotify3.png" alt="Categories Correlation" class="project-image" loading="lazy" />
          <img src="/assets/TikTokSpotify4.png" alt="Ranking Different" class="project-image" loading="lazy" />
          <img src="/assets/TikTokSpotify5.png" alt="Explicit Analysis" class="project-image" loading="lazy" />
        </div>
      </div>
    </header>

    <section class="project-highlights">
      <h2 data-translate="kpiTitle">Kluczowe Wskaźniki Korelacji (TikTok vs Spotify)</h2>
      <div class="section-underline centered-underline"></div>
      <div class="kpi-grid">
        <div class="kpi-card">
          <span class="kpi-value">0.04</span>
          <span class="kpi-label" data-translate="kpi1Label">Pierwotna Korelacja (Całość)</span>
          <span class="kpi-trend trend-down" data-translate="kpi1Trend">Zakłócona przez outliery</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value">0.25</span>
          <span class="kpi-label" data-translate="kpi2Label">Korelacja (bez outlierów)</span>
          <span class="kpi-trend trend-up" data-translate="kpi2Trend">Niska, ale znacząca</span>
        </div>
        <div class="kpi-card">
          <span class="kpi-value">-0.03</span>
          <span class="kpi-label" data-translate="kpi3Label">Korelacja Viral (>1M postów)</span>
          <span class="kpi-trend trend-down" data-translate="kpi3Trend">Brak przełożenia na streaming</span>
        </div>
      </div>
    </section>

    <section class="project-details">
      <h2 data-translate="detailsTitle">Architektura Projektu</h2>
      <div class="section-underline centered-underline"></div>
      
      <div class="details-card" id="project-details-card">
        <div class="toggle-buttons">
          <button class="toggle-btn is-active" onclick="showSection('sectionSQL')" data-translate="tabSQL">1. SQL: Pipeline Danych</button>
          <button class="toggle-btn" onclick="showSection('sectionDAX')" data-translate="tabDAX">2. Power BI: DAX</button>
          <button class="toggle-btn" onclick="showSection('sectionPowerBI')" data-translate="tabPBI">3. Struktura Raportu</button>
          <button class="toggle-btn" onclick="showSection('sectionInsights')" data-translate="tabInsights">4. Analiza & Wnioski</button>
        </div>
        
        <div id="info-sections-container">
          <div id="sectionSQL" class="info-section active" role="region">
            <div id="sqlContentBody"></div>
          </div>
          <div id="sectionDAX" class="info-section" role="region">
            <div id="daxContentBody"></div>
          </div>
          <div id="sectionPowerBI" class="info-section" role="region">
            <div id="pbiContentBody"></div>
          </div>
          <div id="sectionInsights" class="info-section" role="region">
            <div class="analysis-grid">
              <div class="analysis-conclusions">
                <ol id="insightsContentBody"></ol>
              </div>
            </div>
          </div>
        </div>
      </div>
    </section>
    
    <section class="project-files">
      <h2 data-translate="downloadTitle">Pobierz Zasoby Projektu</h2>
      <div class="section-underline centered-underline"></div>
      <div class="files-container">
        <a href="/assets/Most_Streamed_Spotify_Songs.csv" download class="gradient__border__container"><span class="gradient__border__text" data-translate="btnDownloadRaw">Pobierz plik CSV</span></a>
        <a href="/assets/TikTok Spotify Dashboard.pbix" download class="gradient__border__container"><span class="gradient__border__text" data-translate="btnDownloadPBI">Pobierz Plik Power BI</span></a>
      </div>
    </section>
  </main>

  <Footer />

  <style>
    /* STYLE SPECYFICZNE DLA STRONY PROJEKTU */
    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; position: relative; z-index: 1;}
    .section-underline { margin: 20px 0 30px 0; width: 80px; height: 4px; border-radius: 2px; background: var(--line-gradient); }
    .centered-underline { margin: 20px auto 30px auto; }
    
    .project-hero { min-height: 100vh; display: flex; flex-direction: column; justify-content: center; align-items: center; text-align: center; padding: 120px 0 50px 0; }
    .project-hero h1 { font-size: 3.5rem; font-weight: 800; margin-bottom: 20px; color: var(--text-primary); }
    .project-hero p { max-width: 850px; color: var(--text-secondary); font-size: 1.1rem; margin-bottom: 40px; }

    .nav-buttons { display: flex; gap: 15px; flex-wrap: wrap; justify-content: center; }
    .btn-nav { padding: 14px 28px; border-radius: 50px; font-weight: 600; text-decoration: none; transition: all 0.3s ease; border: 1px solid var(--cyan); font-size: 0.95rem; display: inline-block; cursor: pointer; }
    .btn-primary { background: var(--line-gradient); color: white; border: none; box-shadow: 0 4px 15px var(--spotlight-color); }
    .btn-secondary { color: var(--cyan); background: var(--bg-surface); border-color: var(--cyan); }
    .btn-outline { color: var(--text-primary); border: 1px solid var(--border-color); background: var(--bg-surface); }
    
    .btn-nav:hover { transform: translateY(-3px); box-shadow: 0 10px 20px var(--spotlight-color); }
    .btn-outline:hover { background: var(--hover-bg); border-color: var(--cyan); color: var(--cyan); }

    .hero-image-wrapper { perspective: 1000px; margin-top: 50px; width: 100%;}
    .project-image { display: block; width: 100%; height: auto; border-radius: 16px; box-shadow: var(--card-shadow); cursor: pointer; border: 1px solid var(--border-color); transition: transform 0.3s ease, border-color 0.3s ease; }
    .project-image:hover { transform: scale(1.05) rotateY(-5deg) rotateX(5deg); border-color: var(--cyan); }
    .project-gallery-grid { display: grid; grid-template-columns: repeat(6, 1fr); gap: 15px; }
    
    .project-gallery-grid .project-image:nth-child(1) { grid-column: span 3; }
    .project-gallery-grid .project-image:nth-child(2) { grid-column: span 3; }
    .project-gallery-grid .project-image:nth-child(3) { grid-column: span 2; }
    .project-gallery-grid .project-image:nth-child(4) { grid-column: span 2; }
    .project-gallery-grid .project-image:nth-child(5) { grid-column: span 2; }

    /* KPI SECTION */
    .project-highlights { padding: 80px 0; z-index: 1; position: relative;}
    .project-highlights h2, .project-details h2, .project-files h2 { text-align: center; font-size: 2.5rem; font-weight: 700; background: var(--line-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 30px; margin-top: 50px; justify-content: center; }
    
    .kpi-card { background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 15px; padding: 30px; text-align: center; position: relative; overflow: visible; backdrop-filter: blur(10px); transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease, background-color var(--transition-speed) ease; }
    .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at var(--mouse-x, 50%) var(--mouse-y, 50%), var(--spotlight-color), transparent 50%); opacity: 0; transition: opacity 0.3s; border-radius: 15px; pointer-events: none; z-index: 0; }
    .kpi-card > * { position: relative; z-index: 1; }
    .kpi-card:hover { transform: translateY(-8px) scale(1.03); border-color: var(--cyan); box-shadow: var(--card-shadow); }
    .kpi-card:hover::before { opacity: 1; }
    
    .kpi-value { display: block; font-size: 2.2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
    .kpi-label { font-size: 1rem; color: var(--text-secondary); }
    .kpi-trend { display: inline-block; padding: 4px 8px; border-radius: 20px; font-size: 0.85rem; font-weight: 600; margin-top: 10px; }
    .trend-up { background: rgba(33, 163, 102, 0.2); color: #21a366; }
    .trend-down { background: rgba(220, 53, 69, 0.2); color: #dc3545; }

    /* DETAILS SECTION (TABS) */
    .project-details { padding: 80px 0; z-index: 1; position: relative;}
    .details-card { background: var(--bg-surface); padding: 40px; border-radius: 16px; border: 1px solid var(--border-color); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: var(--card-shadow); transition: background-color var(--transition-speed) ease, border-color var(--transition-speed) ease; }
    
    .toggle-buttons { display: flex; justify-content: center; flex-wrap: wrap; gap: 15px; margin-bottom: 40px; }
    .toggle-btn { appearance: none; background: var(--btn-bg); border: 1px solid var(--border-color); color: var(--text-secondary); font-weight: 600; font-family: 'Inter', sans-serif; font-size: 1rem; padding: 12px 24px; border-radius: 12px; cursor: pointer; transition: all .2s ease;}
    .toggle-btn:hover { color: var(--text-primary); border-color: var(--cyan); transform: translateY(-2px); }
    .toggle-btn.is-active { background: var(--line-gradient); color: white; border-color: transparent; transform: scale(1.05); box-shadow: 0 5px 15px var(--spotlight-color); }
    
    .info-section { display: none; margin-top: 20px; padding-top: 30px; border-top: 1px solid var(--border-color); }
    .info-section.active { display: block; animation: fadeIn .4s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    /* ANALIZA WNIOSKÓW (INSIGHTS) */
    .analysis-grid { display: grid; grid-template-columns: 1fr; gap: 40px; align-items: start; }
    :global(.analysis-conclusions ol) { list-style: none; padding-left: 0; counter-reset: conclusion-counter; }
    :global(.analysis-conclusions li) { position: relative; padding-left: 45px; margin-bottom: 35px; background: rgba(255,255,255,0.02); padding: 25px 25px 25px 65px; border-radius: 12px; border: 1px solid var(--border-color); }
    :global(.analysis-conclusions li::before) { counter-increment: conclusion-counter; content: counter(conclusion-counter); position: absolute; left: 15px; top: 25px; width: 35px; height: 35px; border-radius: 50%; background: var(--line-gradient); color: white; font-weight: 700; font-size: 1.1rem; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 10px var(--spotlight-color);}
    :global(.analysis-conclusions li > strong) { display: block; margin-bottom: 5px; color: var(--text-primary); font-size: 1.1rem; }    :global(.analysis-conclusions p) { color: var(--text-secondary); font-size: 1rem; margin-bottom: 15px; }

    /* STRUKTURA RAPORTU */
    :global(.report-structure) { display: grid; grid-template-columns: 1fr 1fr; gap: 25px; }
    :global(.report-card) { background: rgba(255,255,255,0.02); border: 1px solid var(--border-color); border-radius: 16px; padding: 30px; transition: border-color 0.3s, box-shadow 0.3s, transform 0.3s; }
    :global(.report-card:hover) { border-color: var(--cyan); box-shadow: 0 5px 20px var(--spotlight-color); transform: translateY(-5px); }
    :global(.report-card h4) { color: var(--cyan); font-size: 1.3rem; margin-bottom: 15px; font-weight: 700; display: flex; align-items: center; gap: 12px; }
    :global(.report-card p) { color: var(--text-secondary); margin: 0; font-size: 0.95rem; line-height: 1.6; }
    :global(.report-card svg) { width: 28px; height: 28px; color: var(--text-primary); }

    /* SQL & DAX BLOCKS */
    :global(.step-description) { display: block; font-style: italic; color: var(--text-secondary); margin-bottom: 25px; padding-left: 20px; border-left: 3px solid var(--indigo); font-size: 0.95rem; }
    :global(.code-container) { background: var(--code-bg); border-radius: 12px; border: 1px solid var(--border-color); padding: 25px; margin-bottom: 40px; box-shadow: 0 5px 15px rgba(0,0,0,0.3); position: relative;}
    [data-theme="light"] :global(.code-container) { box-shadow: 0 5px 15px rgba(0,0,0,0.05); border-color: rgba(0,0,0,0.1); }
    :global(.code-container::before) { position: absolute; top: 12px; right: 20px; font-size: 0.8rem; font-weight: 700; color: rgba(255,255,255,0.3); }
    :global(.code-container.sql-block::before) { content: 'SQL'; }
    :global(.code-container.dax-block::before) { content: 'DAX'; }
    
    :global(pre) { overflow-x: auto; font-family: 'Consolas', 'Courier New', monospace; color: #c9d1d9; font-size: 0.95rem; }
    
    /* SQL Syntax */
    :global(.sql-key) { color: #ff7b72; font-weight: 600;} 
    :global(.sql-fun) { color: #d2a8ff; } 
    :global(.sql-com) { color: #8b949e; font-style: italic; } 
    :global(.sql-str) { color: #a5d6a7; } 

    /* DAX Syntax */
    :global(.dax-measure) { color: #79C0FF; font-weight: 600;}
    :global(.dax-operator) { color: #ff7b72; font-weight: bold;}
    :global(.dax-fun) { color: #D2A8FF; font-weight: 600;}
    :global(.dax-table) { color: #ffab70; }
    :global(.dax-var) { color: #ff7b72; }

    /* FILES SECTION */
    .project-files { padding: 20px 0; z-index: 1; position: relative;}
    .files-container { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin-top: 50px; }
    .gradient__border__container { display: inline-block; position: relative; padding: 1px; border-radius: 30px; background: var(--line-gradient); background-size: 200% 200%; animation: spin-gradient 6s linear infinite; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; min-width: 150px; text-align: center; text-decoration: none; box-shadow: 0 4px 20px var(--spotlight-color); }
    .gradient__border__container:hover { transform: translateY(-2px); box-shadow: 0 8px 30px var(--spotlight-color); }
    .gradient__border__container .gradient__border__text { display: block; background: var(--bg-surface); border-radius: 29px; padding: 0.8rem 2rem; font-size: 1rem; font-weight: 600; color: var(--text-primary); transition: background 0.3s, color 0.3s; }
    .gradient__border__container:hover .gradient__border__text { background: transparent; color: #fff;}
    @keyframes spin-gradient { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }

    @media (max-width: 900px) {
      .project-hero h1 { font-size: 2.5rem; }
      .nav-buttons { flex-direction: column; width: 100%; }
      .project-gallery-grid { grid-template-columns: 1fr; }
      .project-gallery-grid .project-image:nth-child(n) { grid-column: span 1; }
      :global(.report-structure) { grid-template-columns: 1fr; }
    }
    @media (max-width: 600px) { 
      :global(.analysis-conclusions li) { padding: 20px 15px 20px 15px; } 
      :global(.analysis-conclusions li::before) { top: -15px; left: 15px;} 
    }
  </style>

  <script is:inline>
    document.addEventListener('DOMContentLoaded', () => {
      const translations = {
        pl: {
          pageTitle: "Projekt: TikTok Spotify Correlation Analysis | Portfolio Jakub Nicpoń",
          navHome: "Home",
          navAbout: "O Mnie",
          navProjects: "Projekty",
          heroTitle: "Projekt: TikTok Spotify Correlation Analysis",
          heroDesc: "Analiza wpływu popularności utworów na TikToku na ich odtworzenia na Spotify. Projekt łączy inżynierię danych w SQL Server (czyszczenie, kategoryzacja, tworzenie widoków) z zaawansowanym modelowaniem w Power BI (miary DAX, Drill-Through, badanie korelacji i testy statystyczne T-Value).",
          
          btnSql: "SQL: Inżynieria Danych",
          btnDax: "DAX: Miary & Model",
          btnInsights: "Analiza & Wnioski",
          
          kpiTitle: "Kluczowe Wskaźniki Korelacji (TikTok vs Spotify)",
          kpi1Label: "Pierwotna Korelacja (Całość)",
          kpi1Trend: "Zakłócona przez outliery",
          kpi2Label: "Korelacja (bez outlierów)",
          kpi2Trend: "Niska, ale znacząca",
          kpi3Label: "Korelacja Viral (>1M postów)",
          kpi3Trend: "Brak przełożenia na streaming",
          
          detailsTitle: "Architektura Projektu",
          tabSQL: "1. SQL: Pipeline Danych",
          tabDAX: "2. Power BI: DAX",
          tabPBI: "3. Struktura Raportu",
          tabInsights: "4. Analiza & Wnioski",
          
          downloadTitle: "Pobierz Zasoby Projektu",
          btnDownloadRaw: "Pobierz plik CSV",
          btnDownloadPBI: "Pobierz Plik Power BI",

          sqlContent: `
            <span class="step-description">Krok 1: Utworzenie bazy danych.</span>
            <div class="code-container sql-block"><pre><code><span class="sql-key">CREATE DATABASE</span> SpotifyTikTokAnalysis;
<span class="sql-key">GO</span>

<span class="sql-key">USE</span> SpotifyTikTokAnalysis;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Krok 2: Stworzenie schematów jako etapów pracy z danymi.</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 2. Stworzenie schematow jako etapow pracy z danymi</span>
<span class="sql-key">CREATE SCHEMA</span> raw;
<span class="sql-key">GO</span>
<span class="sql-key">CREATE SCHEMA</span> staging;
<span class="sql-key">GO</span>
<span class="sql-key">CREATE SCHEMA</span> final;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Krok 3: Stworzenie tabeli do importu surowych danych (NVARCHAR).</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 3. Stworzenie tabeli do importu surowych danych z pliku Most Streamed Spotify Songs.csv</span>
<span class="sql-key">CREATE TABLE</span> raw.SpotifySongs (
    Track <span class="sql-key">NVARCHAR</span>(500),
    Album_Name <span class="sql-key">NVARCHAR</span>(500),
    Artist <span class="sql-key">NVARCHAR</span>(500),
    Release_Date <span class="sql-key">NVARCHAR</span>(100),
    ISRC <span class="sql-key">NVARCHAR</span>(100),
    All_Time_Rank <span class="sql-key">NVARCHAR</span>(100),
    Track_Score <span class="sql-key">NVARCHAR</span>(100),
    Spotify_Streams <span class="sql-key">NVARCHAR</span>(100),
    Spotify_Playlist_Count <span class="sql-key">NVARCHAR</span>(100),
    Spotify_Playlist_Reach <span class="sql-key">NVARCHAR</span>(100),
    Spotify_Popularity <span class="sql-key">NVARCHAR</span>(100),
    YouTube_Views <span class="sql-key">NVARCHAR</span>(100),
    YouTube_Likes <span class="sql-key">NVARCHAR</span>(100),
    TikTok_Posts <span class="sql-key">NVARCHAR</span>(100),
    TikTok_Likes <span class="sql-key">NVARCHAR</span>(100),
    TikTok_Views <span class="sql-key">NVARCHAR</span>(100),
    YouTube_Playlist_Reach <span class="sql-key">NVARCHAR</span>(100),
    Apple_Music_Playlist_Count <span class="sql-key">NVARCHAR</span>(100),
    AirPlay_Spins <span class="sql-key">NVARCHAR</span>(100),
    SiriusXM_Spins <span class="sql-key">NVARCHAR</span>(100),
    Deezer_Playlist_Count <span class="sql-key">NVARCHAR</span>(100),
    Deezer_Playlist_Reach <span class="sql-key">NVARCHAR</span>(100),
    Amazon_Playlist_Count <span class="sql-key">NVARCHAR</span>(100),
    Pandora_Streams <span class="sql-key">NVARCHAR</span>(100),
    Pandora_Track_Stations <span class="sql-key">NVARCHAR</span>(100),
    Soundcloud_Streams <span class="sql-key">NVARCHAR</span>(100),
    Shazam_Counts <span class="sql-key">NVARCHAR</span>(100),
    TIDAL_Popularity <span class="sql-key">NVARCHAR</span>(100),
    Explicit_Track <span class="sql-key">NVARCHAR</span>(50)
);
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Krok 4: Stworzenie docelowej tabeli w schemacie 'staging' z właściwymi typami danych (BIGINT ze względu na Power BI).</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 4. Stworzenie docelowej tabeli z własciwymi typami danych</span>
<span class="sql-com">-- przez blad w Power BI trzeba bylo uzyc BIGINT</span>
<span class="sql-key">CREATE TABLE</span> staging.SpotifySongs (
    Id <span class="sql-key">INT IDENTITY</span>(1,1) <span class="sql-key">PRIMARY KEY</span>, <span class="sql-com">-- autoinkrementacja</span>
    Track <span class="sql-key">NVARCHAR</span>(500),
    Album_Name <span class="sql-key">NVARCHAR</span>(500),
    Artist <span class="sql-key">NVARCHAR</span>(500),
    Release_Date <span class="sql-key">DATE</span>,
    ISRC <span class="sql-key">NVARCHAR</span>(100),
    All_Time_Rank <span class="sql-key">BIGINT</span>, <span class="sql-com">-- zmiana na BIGINT</span>
    Track_Score <span class="sql-key">FLOAT</span>,
    Spotify_Streams <span class="sql-key">BIGINT</span>,
    Spotify_Playlist_Count <span class="sql-key">BIGINT</span>, <span class="sql-com">-- zmiana na BIGINT</span>
    Spotify_Popularity <span class="sql-key">BIGINT</span>, <span class="sql-com">-- zmiana na BIGINT</span>
    YouTube_Views <span class="sql-key">BIGINT</span>,
    YouTube_Likes <span class="sql-key">BIGINT</span>,
    TikTok_Posts <span class="sql-key">BIGINT</span>,
    TikTok_Likes <span class="sql-key">BIGINT</span>,
    TikTok_Views <span class="sql-key">BIGINT</span>,
    Explicit_Track <span class="sql-key">BIT</span> <span class="sql-com">-- true/false - pozniej w Power BI zamiana na Explicit/Clean</span>
);
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Krok 5: Wyczyszczenie i import danych z warstwy RAW do STAGING. Usunięcie przecinków i konwersja.</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 5. Wyczyszczenie i import danych z warstwy RAW do STAGING</span>
<span class="sql-key">INSERT INTO</span> staging.SpotifySongs (
    Track, Album_Name, Artist, Release_Date, ISRC, All_Time_Rank, Track_Score,
    Spotify_Streams, Spotify_Playlist_Count, Spotify_Popularity,
    YouTube_Views, YouTube_Likes, TikTok_Posts, TikTok_Likes, TikTok_Views, Explicit_Track
)
<span class="sql-key">SELECT</span>
    <span class="sql-fun">TRIM</span>(Track),
    <span class="sql-fun">TRIM</span>(Album_Name),
    <span class="sql-fun">TRIM</span>(Artist),
    <span class="sql-fun">TRY_CAST</span>(Release_Date <span class="sql-key">AS DATE</span>),
    <span class="sql-fun">TRIM</span>(ISRC),
    <span class="sql-com">-- usuniecie przecinkow w celu unikniecia bledow przy liczbach</span>
    <span class="sql-com">-- uzywamy BIGINT dla bezpieczenstwa przy duzych liczbach</span>
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(All_Time_Rank, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(Track_Score, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS FLOAT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(Spotify_Streams, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(Spotify_Playlist_Count, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(Spotify_Popularity, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(YouTube_Views, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(YouTube_Likes, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(TikTok_Posts, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(TikTok_Likes, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(TikTok_Views, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(Explicit_Track <span class="sql-key">AS BIT</span>)
    <span class="sql-key">FROM</span> raw.SpotifySongs;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Krok 6: Stworzenie widoku z kategoryzacją utworów ze względu na liczbę postów na TikToku.</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 6. Stworzenie widoku z podstawowymi metrykami i kategoryzacja utworow na TikToku</span>
<span class="sql-key">CREATE OR ALTER VIEW</span> final.TikTok_Categories <span class="sql-key">AS</span>
<span class="sql-key">WITH</span> CategorizedTracks <span class="sql-key">AS</span> (
    <span class="sql-key">SELECT</span>
        Id,
        Spotify_Streams,
        YouTube_Views,
        TikTok_Posts,
        <span class="sql-key">CASE</span>
            <span class="sql-key">WHEN</span> TikTok_Posts >= 1000000 <span class="sql-key">THEN</span> <span class="sql-str">'1. Viral (> 1M posts)'</span>
            <span class="sql-key">WHEN</span> TikTok_Posts >= 100000 <span class="sql-key">THEN</span> <span class="sql-str">'2. Popular (100k - 1M posts)'</span>
            <span class="sql-key">WHEN</span> TikTok_Posts > 0 <span class="sql-key">THEN</span> <span class="sql-str">'3. Niche (< 100k posts)'</span>
            <span class="sql-key">ELSE</span> <span class="sql-str">'4. No TikTok Data/Zero'</span>
        <span class="sql-key">END AS</span> TikTok_Category
    <span class="sql-key">FROM</span> staging.SpotifySongs
)
<span class="sql-key">SELECT</span>
    TikTok_Category,
    <span class="sql-fun">COUNT</span>(Id) <span class="sql-key">AS</span> Number_Of_Tracks,
    <span class="sql-fun">AVG</span>(<span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Avg_Spotify_Streams,
    <span class="sql-fun">AVG</span>(<span class="sql-fun">CAST</span>(YouTube_Views <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Avg_YouTube_Views
<span class="sql-key">FROM</span> CategorizedTracks
<span class="sql-key">GROUP BY</span> TikTok_Category;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Krok 7: Stworzenie widoku agregującego wyniki per artysta.</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 7. Stworzenie widoku agregujacego wyniki per artysta</span>
<span class="sql-key">CREATE OR ALTER VIEW</span> final.Artist_Performance <span class="sql-key">AS</span>
<span class="sql-key">SELECT</span>
    Artist,
    <span class="sql-fun">COUNT</span>(Id) <span class="sql-key">AS</span> Tracks_Count,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_Spotify_Streams,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(TikTok_Posts <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_TikTok_Posts,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(TikTok_Views <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_TikTok_Views,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(YouTube_Views <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_YouTube_Views,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(Spotify_Playlist_Count <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_Spotify_Playlists
<span class="sql-key">FROM</span> staging.SpotifySongs
<span class="sql-key">WHERE</span> Artist <span class="sql-key">IS NOT NULL AND</span> Artist != <span class="sql-str">''</span>
<span class="sql-key">GROUP BY</span> Artist
<span class="sql-key">HAVING</span> <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">IS NOT NULL</span> <span class="sql-com">-- bez sensu analizowac wplyw TikToka na 0 odsluchan</span>
   <span class="sql-key">AND</span> <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS BIGINT</span>)) > 0;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Krok 8: Stworzenie widoku porównującego rankingi (Spotify Rank vs TikTok Rank).</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 8. Stworzenie widoku porownujacego wyniki (ranking)</span>
<span class="sql-key">CREATE VIEW</span> final.Platform_Rankings <span class="sql-key">AS</span>
    <span class="sql-key">SELECT</span>
        track,
        artist,
        Spotify_Streams,
        TikTok_Views,
        <span class="sql-fun">DENSE_RANK</span>() <span class="sql-fun">OVER</span>(<span class="sql-key">ORDER BY</span> Spotify_Streams <span class="sql-key">DESC</span>) <span class="sql-key">AS</span> Spotify_Rank,
        <span class="sql-fun">DENSE_RANK</span>() <span class="sql-fun">OVER</span>(<span class="sql-key">ORDER BY</span> TikTok_Views <span class="sql-key">DESC</span>) <span class="sql-key">AS</span> TikTok_Rank,
        (<span class="sql-fun">CAST</span>(<span class="sql-fun">DENSE_RANK</span>() <span class="sql-fun">OVER</span>(<span class="sql-key">ORDER BY</span> TikTok_Views <span class="sql-key">DESC</span>) <span class="sql-key">AS INT</span>) - <span class="sql-fun">CAST</span>(<span class="sql-fun">DENSE_RANK</span>() <span class="sql-fun">OVER</span>(<span class="sql-key">ORDER BY</span> Spotify_Streams <span class="sql-key">DESC</span>) <span class="sql-key">AS INT</span>)) <span class="sql-key">AS</span> Ranking_Diff
<span class="sql-key">FROM</span> staging.SpotifySongs
<span class="sql-key">WHERE</span> Spotify_Streams <span class="sql-key">IS NOT NULL AND</span> TikTok_Views <span class="sql-key">IS NOT NULL AND</span> TikTok_Views > 0;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Krok 9: Stworzenie widoku ze wskaźnikami konwersji (Engagement Ratio).</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 9. Stworzenie widoku ze wskaznikami konwersji (engagement)</span>
<span class="sql-key">CREATE OR ALTER VIEW</span> final.Engagement_Ratio <span class="sql-key">AS</span>
<span class="sql-key">SELECT</span>
    Id,
    Track,
    Artist,
    Release_Date,
    <span class="sql-fun">YEAR</span>(Release_Date) <span class="sql-key">AS</span> Release_Year,
    Explicit_Track,
    Spotify_Streams,
    Spotify_Playlist_Count,
    Spotify_Popularity,
    TikTok_Posts,
    TikTok_Views,
    TikTok_Likes,
    YouTube_Views,
    <span class="sql-key">CASE</span>
        <span class="sql-key">WHEN</span> TikTok_Posts >= 1000000 <span class="sql-key">THEN</span> <span class="sql-str">'1. Viral (> 1M posts)'</span>
        <span class="sql-key">WHEN</span> TikTok_Posts >= 100000 <span class="sql-key">THEN</span> <span class="sql-str">'2. Popular (100k - 1M posts)'</span>
        <span class="sql-key">WHEN</span> TikTok_Posts > 0 <span class="sql-key">THEN</span> <span class="sql-str">'3. Niche (< 100k posts)'</span>
        <span class="sql-key">ELSE</span> <span class="sql-str">'4. No TikTok Data/Zero'</span>
    <span class="sql-key">END AS</span> TikTok_Category,
    <span class="sql-fun">ROUND</span>(<span class="sql-key">CASE</span>
        <span class="sql-key">WHEN</span> TikTok_Views > 0 <span class="sql-key">THEN</span> <span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS FLOAT</span>) / TikTok_Views <span class="sql-key">ELSE</span> 0 <span class="sql-key">END</span>, 2) <span class="sql-key">AS</span> Spotify_To_TikTok_Ratio,
    <span class="sql-fun">ROUND</span>(<span class="sql-key">CASE</span>
        <span class="sql-key">WHEN</span> TikTok_Views > 0 <span class="sql-key">THEN</span> (<span class="sql-fun">CAST</span>(TikTok_Likes <span class="sql-key">AS FLOAT</span>) / TikTok_Views) * 100 <span class="sql-key">ELSE</span> 0 <span class="sql-key">END</span>, 2) <span class="sql-key">AS</span> TikTok_Engagement_Rate
<span class="sql-key">FROM</span> staging.SpotifySongs;
<span class="sql-key">GO</span></code></pre></div>`,
          
          daxContent: `
            <span class="step-description">Przegląd 13 użytych w projekcie miar DAX. Najważniejszym punktem było obliczenie rzetelnej korelacji. Standardowe miary ulegały zakłóceniom przez tzw. Outliery (mega-hity). Musiałem zastosować dynamiczne filtrowanie z użyciem PERCENTILEX.INC odcinając górne 5% wyników i ostatecznie przetestować je wskaźnikiem T-Value.</span>
            
            <div class="code-container dax-block"><p><strong>1. Track Count</strong></p><pre><code><span class="dax-measure">Track Count</span> <span class="dax-operator">=</span> <span class="dax-fun">COUNT</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Id])</code></pre></div>
            <div class="code-container dax-block"><p><strong>2. Total TikTok Views</strong></p><pre><code><span class="dax-measure">Total TikTok Views</span> <span class="dax-operator">=</span> <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])</code></pre></div>
            <div class="code-container dax-block"><p><strong>3. Total TikTok Posts</strong></p><pre><code><span class="dax-measure">Total TikTok Posts</span> <span class="dax-operator">=</span> <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Posts])</code></pre></div>
            <div class="code-container dax-block"><p><strong>4. Total Spotify Streams</strong></p><pre><code><span class="dax-measure">Total Spotify Streams</span> <span class="dax-operator">=</span> <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])</code></pre></div>

            <div class="code-container dax-block"><p><strong>5. Avg Spotify to TikTok Ratio</strong><br><span class="sql-com">// Zamiast tradycyjnej średniej, która przekłamuje outliery, sumuję całość i dzielę (ważona metryka)</span></p><pre><code><span class="dax-measure">Avg Spotify to TikTok Ratio</span> <span class="dax-operator">=</span> 
<span class="dax-fun">DIVIDE</span>(
    <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams]), 
    <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views]),
    <span class="dax-operator">0</span>
)</code></pre></div>

            <div class="code-container dax-block"><p><strong>6. Avg TikTok Engagement</strong></p><pre><code><span class="dax-measure">Avg TikTok Engagement</span> <span class="dax-operator">=</span> <span class="dax-fun">AVERAGE</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Engagement_Rate]) <span class="dax-operator">/</span> <span class="dax-operator">100</span> <span class="sql-com">// zmiana na %</span></code></pre></div>

            <div class="code-container dax-block"><p><strong>7. Correlation TikTok Spotify (Całość)</strong></p><pre><code><span class="dax-measure">Correlation TikTok Spotify</span> <span class="dax-operator">=</span> 
<span class="sql-com">// srednia dla calego zbioru</span>
<span class="dax-var">VAR</span> AVG_TikTok <span class="dax-operator">=</span> <span class="dax-fun">AVERAGE</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])
<span class="dax-var">VAR</span> AVG_Spotify <span class="dax-operator">=</span> <span class="dax-fun">AVERAGE</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])
<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(<span class="sql-com">--licznik: suma iloczynow odchylen, mianownik: odchylenia standardowe</span>
        <span class="dax-fun">SUMX</span>(
            <span class="dax-table">'final Engagement_Ratio'</span>, 
            (<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok) <span class="dax-operator">*</span> (<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify)
        ),
        <span class="dax-fun">SQRT</span>(
            <span class="dax-fun">SUMX</span>(<span class="dax-table">'final Engagement_Ratio'</span>, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok, <span class="dax-operator">2</span>)) <span class="dax-operator">*</span> <span class="dax-fun">SUMX</span>(<span class="dax-table">'final Engagement_Ratio'</span>, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify, <span class="dax-operator">2</span>))
        )
    )</code></pre></div>

            <div class="code-container dax-block"><p><strong>8. Correlation No Outliers</strong></p><pre><code><span class="dax-measure">Correlation No Outliers</span> <span class="dax-operator">=</span> 
<span class="sql-com">// progi dla outlierow -> odciecie top i min 5% wartosci</span>
<span class="dax-var">VAR</span> TopSpotify <span class="dax-operator">=</span> <span class="dax-fun">PERCENTILEX.INC</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams], <span class="dax-operator">0.95</span>)
<span class="dax-var">VAR</span> TopTikTok <span class="dax-operator">=</span> <span class="dax-fun">PERCENTILEX.INC</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views], <span class="dax-operator">0.95</span>)

<span class="sql-com">// tabela bez ogromnych wartosci</span>
<span class="dax-var">VAR</span> CleanTable <span class="dax-operator">=</span> 
    <span class="dax-fun">FILTER</span>(
        <span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>),
        <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator"><</span> TopSpotify <span class="dax-operator">&&</span> 
        <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator"><</span> TopTikTok <span class="dax-operator">&&</span>
        <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">></span> <span class="dax-operator">0</span> <span class="sql-com">// bez zer zeby nie psuly sredniej</span>
    )

<span class="sql-com">// srednia dla normalnych piosenek bez ogromnych outlierow -> averagex zostawia przesiane dane z powyzszego filtra</span>
<span class="dax-var">VAR</span> AVG_T <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(CleanTable, <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])
<span class="dax-var">VAR</span> AVG_S <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(CleanTable, <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])

<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(
        <span class="dax-fun">SUMX</span>(CleanTable, (<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_T) <span class="dax-operator">*</span> (<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_S)),
        <span class="dax-fun">SQRT</span>(
            <span class="dax-fun">SUMX</span>(CleanTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_T, <span class="dax-operator">2</span>)) <span class="dax-operator">*</span> <span class="dax-fun">SUMX</span>(CleanTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_S, <span class="dax-operator">2</span>))
        )
    )</code></pre></div>

            <div class="code-container dax-block"><p><strong>9. Correlation No TikTok</strong></p><pre><code><span class="dax-measure">Correlation No TikTok</span> <span class="dax-operator">=</span> 
<span class="dax-var">VAR</span> SubTable <span class="dax-operator">=</span> <span class="dax-fun">FILTER</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Category] <span class="dax-operator">=</span> <span class="dax-string">"4. No TikTok Data/Zero"</span>)
<span class="dax-var">VAR</span> AVG_TikTok <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])
<span class="dax-var">VAR</span> AVG_Spotify <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])
<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(
        <span class="dax-fun">SUMX</span>(SubTable, (<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok) <span class="dax-operator">*</span> (<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify)),
        <span class="dax-fun">SQRT</span>(<span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok, <span class="dax-operator">2</span>)) <span class="dax-operator">*</span> <span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify, <span class="dax-operator">2</span>)))
    )</code></pre></div>

            <div class="code-container dax-block"><p><strong>10. Correlation Niche TikTok</strong></p><pre><code><span class="dax-measure">Correlation Niche TikTok</span> <span class="dax-operator">=</span> 
<span class="dax-var">VAR</span> SubTable <span class="dax-operator">=</span> <span class="dax-fun">FILTER</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Category] <span class="dax-operator">=</span> <span class="dax-string">"3. Niche (< 100k posts)"</span>)
