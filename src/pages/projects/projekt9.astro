    Deezer_Playlist_Reach <span class="sql-key">NVARCHAR</span>(100),
    Amazon_Playlist_Count <span class="sql-key">NVARCHAR</span>(100),
    Pandora_Streams <span class="sql-key">NVARCHAR</span>(100),
