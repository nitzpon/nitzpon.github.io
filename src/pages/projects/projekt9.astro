          insightsContent: `
            <li>
              <strong>The Illusion of No Connection (Correlation: 0.04)</strong>
              <p>The initial correlation of barely 0.04 suggested a complete lack of relationship between the platforms. This turned out to be an error of scale and data pollution. The global result was massively skewed by mega-hits (the top 5% of tracks, e.g., The Weeknd - Blinding Lights), which generate billions of streams via traditional media (radio, major Spotify playlists), completely independent of TikTok trends.</p>
            </li>
            <li>
              <strong>The Real Power of TikTok (Correlation: 0.25)</strong>
              <p>After cutting off the outliers with the DAX <code>PERCENTILEX.INC</code> measure, the correlation increased to 0.25. This is the most crucial proof in the project, backed up by a high <strong>T-statistic</strong>. For 95% of tracks (niche and aspiring artists), there is a clear, positive relationship between TikTok reach and Spotify consumption.</p>
            </li>
            <li>
              <strong>Memes don't earn on Spotify (Viral Correlation: -0.03)</strong>
              <p>In the highest popularity category (Viral > 1M posts), the correlation vanishes and even turns negative. Achieving extreme visual virality does not guarantee musical success. The song often becomes merely a "background for short videos," which doesn't persuade the user to switch to Spotify and listen to the full, monetizable track.</p>
            </li>`
        }
      };

      const setLocalLanguage = (lang) => {
        document.querySelectorAll('[data-translate]').forEach(el => {
          const key = el.dataset.translate;
          if (translations[lang] && translations[lang][key]) { 
            el.innerHTML = translations[lang][key]; 
          }
        });

        if(translations[lang]) {
          const sqlBody = document.getElementById('sqlContentBody');
          if(sqlBody) sqlBody.innerHTML = translations[lang].sqlContent;
          
          const daxBody = document.getElementById('daxContentBody');
          if(daxBody) daxBody.innerHTML = translations[lang].daxContent;
          
          const pbiBody = document.getElementById('pbiContentBody');
          if(pbiBody) pbiBody.innerHTML = translations[lang].pbiContent;
          
          const insightsBody = document.getElementById('insightsContentBody');
          if(insightsBody) insightsBody.innerHTML = translations[lang].insightsContent;
        }
      };

      const preferredLanguage = localStorage.getItem('preferredLanguage') || 'pl';
      setLocalLanguage(preferredLanguage);

      document.querySelectorAll('.lang-btn').forEach(button => {
        button.addEventListener('click', () => {
          setLocalLanguage(button.dataset.lang);
        });
      });

      // ZAKŁADKI (TABS)
      window.showSection = function(id) {
        document.querySelectorAll(".info-section").forEach(s => s.classList.remove("active"));
        document.querySelectorAll(".toggle-btn").forEach(b => b.classList.remove("is-active"));
        
        const targetSection = document.getElementById(id);
        if (targetSection) targetSection.classList.add("active");
        
        const btn = document.querySelector(`.toggle-btn[onclick="showSection('${id}')"]`);
        if(btn) btn.classList.add("is-active");
      };

      // SMOOTH SCROLL (LENIS)
      document.querySelectorAll('a[href^="#"]').forEach(anchor => {
        anchor.addEventListener('click', function (e) {
          e.preventDefault();
          const targetId = this.getAttribute('href');
          
          if (targetId.length > 1 && window.lenis) {
            window.lenis.scrollTo(targetId, {
              offset: -90, 
              duration: 1.5,
              easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t))
            });
          }
        });
      });

      // GLOW EFEKT
      document.querySelectorAll('.kpi-card, .report-card').forEach(card => {
        card.addEventListener('mousemove', (e) => {
          const rect = card.getBoundingClientRect();
          const x = e.clientX - rect.left;
          const y = e.clientY - rect.top;
          card.style.setProperty('--mouse-x', `${x}px`);
          card.style.setProperty('--mouse-y', `${y}px`);
        });
      });

      // LIGHTBOX
      const projectImages = document.querySelectorAll('.project-image');
      projectImages.forEach(img => {
        img.addEventListener('click', () => {
          if(window.openLightbox) { window.openLightbox(img.getAttribute('src')); }
        });
      });

    });
  </script>
</BaseLayout>