            <span class="step-description">Step 5: Clean and import data from RAW to STAGING layer. Remove commas and cast data types.</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 5. Clean and import data from RAW to STAGING layer</span>
<span class="sql-key">INSERT INTO</span> staging.SpotifySongs (
    Track, Album_Name, Artist, Release_Date, ISRC, All_Time_Rank, Track_Score,
    Spotify_Streams, Spotify_Playlist_Count, Spotify_Popularity,
    YouTube_Views, YouTube_Likes, TikTok_Posts, TikTok_Likes, TikTok_Views, Explicit_Track
)
<span class="sql-key">SELECT</span>
    <span class="sql-fun">TRIM</span>(Track),
    <span class="sql-fun">TRIM</span>(Album_Name),
    <span class="sql-fun">TRIM</span>(Artist),
    <span class="sql-fun">TRY_CAST</span>(Release_Date <span class="sql-key">AS DATE</span>),
    <span class="sql-fun">TRIM</span>(ISRC),
    <span class="sql-com">-- remove commas to avoid numerical errors</span>
    <span class="sql-com">-- using BIGINT for safety with large numbers</span>
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(All_Time_Rank, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(Track_Score, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS FLOAT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(Spotify_Streams, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(Spotify_Playlist_Count, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(Spotify_Popularity, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(YouTube_Views, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(YouTube_Likes, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(TikTok_Posts, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(TikTok_Likes, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(<span class="sql-fun">REPLACE</span>(TikTok_Views, <span class="sql-str">','</span>, <span class="sql-str">''</span>) <span class="sql-key">AS BIGINT</span>),
    <span class="sql-fun">TRY_CAST</span>(Explicit_Track <span class="sql-key">AS BIT</span>)
    <span class="sql-key">FROM</span> raw.SpotifySongs;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Step 6: Create a view with track categorization based on the number of TikTok posts.</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 6. Create a view with basic metrics and track categorization on TikTok</span>
<span class="sql-key">CREATE OR ALTER VIEW</span> final.TikTok_Categories <span class="sql-key">AS</span>
<span class="sql-key">WITH</span> CategorizedTracks <span class="sql-key">AS</span> (
    <span class="sql-key">SELECT</span>
        Id,
        Spotify_Streams,
        YouTube_Views,
        TikTok_Posts,
        <span class="sql-key">CASE</span>
            <span class="sql-key">WHEN</span> TikTok_Posts >= 1000000 <span class="sql-key">THEN</span> <span class="sql-str">'1. Viral (> 1M posts)'</span>
            <span class="sql-key">WHEN</span> TikTok_Posts >= 100000 <span class="sql-key">THEN</span> <span class="sql-str">'2. Popular (100k - 1M posts)'</span>
            <span class="sql-key">WHEN</span> TikTok_Posts > 0 <span class="sql-key">THEN</span> <span class="sql-str">'3. Niche (< 100k posts)'</span>
            <span class="sql-key">ELSE</span> <span class="sql-str">'4. No TikTok Data/Zero'</span>
        <span class="sql-key">END AS</span> TikTok_Category
    <span class="sql-key">FROM</span> staging.SpotifySongs
)
<span class="sql-key">SELECT</span>
    TikTok_Category,
    <span class="sql-fun">COUNT</span>(Id) <span class="sql-key">AS</span> Number_Of_Tracks,
    <span class="sql-fun">AVG</span>(<span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Avg_Spotify_Streams,
    <span class="sql-fun">AVG</span>(<span class="sql-fun">CAST</span>(YouTube_Views <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Avg_YouTube_Views
<span class="sql-key">FROM</span> CategorizedTracks
<span class="sql-key">GROUP BY</span> TikTok_Category;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Step 7: Create a view aggregating results per artist.</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 7. Create a view aggregating results per artist</span>
<span class="sql-key">CREATE OR ALTER VIEW</span> final.Artist_Performance <span class="sql-key">AS</span>
<span class="sql-key">SELECT</span>
    Artist,
    <span class="sql-fun">COUNT</span>(Id) <span class="sql-key">AS</span> Tracks_Count,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_Spotify_Streams,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(TikTok_Posts <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_TikTok_Posts,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(TikTok_Views <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_TikTok_Views,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(YouTube_Views <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_YouTube_Views,
    <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(Spotify_Playlist_Count <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">AS</span> Total_Spotify_Playlists
<span class="sql-key">FROM</span> staging.SpotifySongs
<span class="sql-key">WHERE</span> Artist <span class="sql-key">IS NOT NULL AND</span> Artist != <span class="sql-str">''</span>
<span class="sql-key">GROUP BY</span> Artist
<span class="sql-key">HAVING</span> <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS BIGINT</span>)) <span class="sql-key">IS NOT NULL</span> <span class="sql-com">-- no point in analyzing TikTok's impact on 0 streams</span>
   <span class="sql-key">AND</span> <span class="sql-fun">SUM</span>(<span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS BIGINT</span>)) > 0;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Step 8: Create a view comparing rankings (Spotify Rank vs TikTok Rank).</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 8. Create a view comparing results (ranking)</span>
<span class="sql-key">CREATE VIEW</span> final.Platform_Rankings <span class="sql-key">AS</span>
    <span class="sql-key">SELECT</span>
        track,
        artist,
        Spotify_Streams,
        TikTok_Views,
        <span class="sql-fun">DENSE_RANK</span>() <span class="sql-fun">OVER</span>(<span class="sql-key">ORDER BY</span> Spotify_Streams <span class="sql-key">DESC</span>) <span class="sql-key">AS</span> Spotify_Rank,
        <span class="sql-fun">DENSE_RANK</span>() <span class="sql-fun">OVER</span>(<span class="sql-key">ORDER BY</span> TikTok_Views <span class="sql-key">DESC</span>) <span class="sql-key">AS</span> TikTok_Rank,
        (<span class="sql-fun">CAST</span>(<span class="sql-fun">DENSE_RANK</span>() <span class="sql-fun">OVER</span>(<span class="sql-key">ORDER BY</span> TikTok_Views <span class="sql-key">DESC</span>) <span class="sql-key">AS INT</span>) - <span class="sql-fun">CAST</span>(<span class="sql-fun">DENSE_RANK</span>() <span class="sql-fun">OVER</span>(<span class="sql-key">ORDER BY</span> Spotify_Streams <span class="sql-key">DESC</span>) <span class="sql-key">AS INT</span>)) <span class="sql-key">AS</span> Ranking_Diff
<span class="sql-key">FROM</span> staging.SpotifySongs
<span class="sql-key">WHERE</span> Spotify_Streams <span class="sql-key">IS NOT NULL AND</span> TikTok_Views <span class="sql-key">IS NOT NULL AND</span> TikTok_Views > 0;
<span class="sql-key">GO</span></code></pre></div>

            <span class="step-description">Step 9: Create a view with conversion metrics (Engagement Ratio).</span>
            <div class="code-container sql-block"><pre><code><span class="sql-com">-- 9. Create a view with conversion metrics (engagement)</span>
<span class="sql-key">CREATE OR ALTER VIEW</span> final.Engagement_Ratio <span class="sql-key">AS</span>
<span class="sql-key">SELECT</span>
    Id,
    Track,
    Artist,
    Release_Date,
    <span class="sql-fun">YEAR</span>(Release_Date) <span class="sql-key">AS</span> Release_Year,
    Explicit_Track,
    Spotify_Streams,
    Spotify_Playlist_Count,
    Spotify_Popularity,
    TikTok_Posts,
    TikTok_Views,
    TikTok_Likes,
    YouTube_Views,
    <span class="sql-key">CASE</span>
        <span class="sql-key">WHEN</span> TikTok_Posts >= 1000000 <span class="sql-key">THEN</span> <span class="sql-str">'1. Viral (> 1M posts)'</span>
        <span class="sql-key">WHEN</span> TikTok_Posts >= 100000 <span class="sql-key">THEN</span> <span class="sql-str">'2. Popular (100k - 1M posts)'</span>
        <span class="sql-key">WHEN</span> TikTok_Posts > 0 <span class="sql-key">THEN</span> <span class="sql-str">'3. Niche (< 100k posts)'</span>
        <span class="sql-key">ELSE</span> <span class="sql-str">'4. No TikTok Data/Zero'</span>
    <span class="sql-key">END AS</span> TikTok_Category,
    <span class="sql-fun">ROUND</span>(<span class="sql-key">CASE</span>
        <span class="sql-key">WHEN</span> TikTok_Views > 0 <span class="sql-key">THEN</span> <span class="sql-fun">CAST</span>(Spotify_Streams <span class="sql-key">AS FLOAT</span>) / TikTok_Views <span class="sql-key">ELSE</span> 0 <span class="sql-key">END</span>, 2) <span class="sql-key">AS</span> Spotify_To_TikTok_Ratio,
    <span class="sql-fun">ROUND</span>(<span class="sql-key">CASE</span>
        <span class="sql-key">WHEN</span> TikTok_Views > 0 <span class="sql-key">THEN</span> (<span class="sql-fun">CAST</span>(TikTok_Likes <span class="sql-key">AS FLOAT</span>) / TikTok_Views) * 100 <span class="sql-key">ELSE</span> 0 <span class="sql-key">END</span>, 2) <span class="sql-key">AS</span> TikTok_Engagement_Rate
<span class="sql-key">FROM</span> staging.SpotifySongs;
<span class="sql-key">GO</span></code></pre></div>`,
          
          daxContent: `
            <span class="step-description">Overview of the 13 DAX measures used in the project. The most important point was to calculate a reliable correlation. Standard measures were distorted by Outliers (mega-hits). I had to apply dynamic filtering using PERCENTILEX.INC, cutting off the top 5% of results, and finally test them with the T-Value indicator.</span>
            
            <div class="code-container dax-block"><p><strong>1. Track Count</strong></p><pre><code><span class="dax-measure">Track Count</span> <span class="dax-operator">=</span> <span class="dax-fun">COUNT</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Id])</code></pre></div>
            <div class="code-container dax-block"><p><strong>2. Total TikTok Views</strong></p><pre><code><span class="dax-measure">Total TikTok Views</span> <span class="dax-operator">=</span> <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])</code></pre></div>
            <div class="code-container dax-block"><p><strong>3. Total TikTok Posts</strong></p><pre><code><span class="dax-measure">Total TikTok Posts</span> <span class="dax-operator">=</span> <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Posts])</code></pre></div>
            <div class="code-container dax-block"><p><strong>4. Total Spotify Streams</strong></p><pre><code><span class="dax-measure">Total Spotify Streams</span> <span class="dax-operator">=</span> <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])</code></pre></div>

            <div class="code-container dax-block"><p><strong>5. Avg Spotify to TikTok Ratio</strong><br><span class="sql-com">// Instead of a traditional average that skews outliers, I sum everything and divide (weighted metric)</span></p><pre><code><span class="dax-measure">Avg Spotify to TikTok Ratio</span> <span class="dax-operator">=</span> 
<span class="dax-fun">DIVIDE</span>(
    <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams]), 
    <span class="dax-fun">SUM</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views]),
    <span class="dax-operator">0</span>
)</code></pre></div>

            <div class="code-container dax-block"><p><strong>6. Avg TikTok Engagement</strong></p><pre><code><span class="dax-measure">Avg TikTok Engagement</span> <span class="dax-operator">=</span> <span class="dax-fun">AVERAGE</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Engagement_Rate]) <span class="dax-operator">/</span> <span class="dax-operator">100</span> <span class="sql-com">// converted to %</span></code></pre></div>

            <div class="code-container dax-block"><p><strong>7. Correlation TikTok Spotify (Overall)</strong></p><pre><code><span class="dax-measure">Correlation TikTok Spotify</span> <span class="dax-operator">=</span> 
<span class="sql-com">// average for the entire dataset</span>
<span class="dax-var">VAR</span> AVG_TikTok <span class="dax-operator">=</span> <span class="dax-fun">AVERAGE</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])
<span class="dax-var">VAR</span> AVG_Spotify <span class="dax-operator">=</span> <span class="dax-fun">AVERAGE</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])
<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(<span class="sql-com">--numerator: sum of product of deviations, denominator: standard deviations</span>
        <span class="dax-fun">SUMX</span>(
            <span class="dax-table">'final Engagement_Ratio'</span>, 
            (<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok) <span class="dax-operator">*</span> (<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify)
        ),
        <span class="dax-fun">SQRT</span>(
            <span class="dax-fun">SUMX</span>(<span class="dax-table">'final Engagement_Ratio'</span>, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok, <span class="dax-operator">2</span>)) <span class="dax-operator">*</span> <span class="dax-fun">SUMX</span>(<span class="dax-table">'final Engagement_Ratio'</span>, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify, <span class="dax-operator">2</span>))
        )
    )</code></pre></div>

            <div class="code-container dax-block"><p><strong>8. Correlation No Outliers</strong></p><pre><code><span class="dax-measure">Correlation No Outliers</span> <span class="dax-operator">=</span> 
<span class="sql-com">// thresholds for outliers -> cutting off the top 5% values</span>
<span class="dax-var">VAR</span> TopSpotify <span class="dax-operator">=</span> <span class="dax-fun">PERCENTILEX.INC</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams], <span class="dax-operator">0.95</span>)
<span class="dax-var">VAR</span> TopTikTok <span class="dax-operator">=</span> <span class="dax-fun">PERCENTILEX.INC</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views], <span class="dax-operator">0.95</span>)

<span class="sql-com">// table without massive values</span>
<span class="dax-var">VAR</span> CleanTable <span class="dax-operator">=</span> 
    <span class="dax-fun">FILTER</span>(
        <span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>),
        <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator"><</span> TopSpotify <span class="dax-operator">&&</span> 
        <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator"><</span> TopTikTok <span class="dax-operator">&&</span>
        <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">></span> <span class="dax-operator">0</span> <span class="sql-com">// excluding zeros so they don't skew the average</span>
    )

<span class="sql-com">// average for normal songs without huge outliers -> averagex keeps the filtered data</span>
<span class="dax-var">VAR</span> AVG_T <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(CleanTable, <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])
<span class="dax-var">VAR</span> AVG_S <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(CleanTable, <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])

<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(
        <span class="dax-fun">SUMX</span>(CleanTable, (<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_T) <span class="dax-operator">*</span> (<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_S)),
        <span class="dax-fun">SQRT</span>(
            <span class="dax-fun">SUMX</span>(CleanTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_T, <span class="dax-operator">2</span>)) <span class="dax-operator">*</span> <span class="dax-fun">SUMX</span>(CleanTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_S, <span class="dax-operator">2</span>))
        )
    )</code></pre></div>

            <div class="code-container dax-block"><p><strong>9. Correlation No TikTok</strong></p><pre><code><span class="dax-measure">Correlation No TikTok</span> <span class="dax-operator">=</span> 
<span class="dax-var">VAR</span> SubTable <span class="dax-operator">=</span> <span class="dax-fun">FILTER</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Category] <span class="dax-operator">=</span> <span class="dax-string">"4. No TikTok Data/Zero"</span>)
<span class="dax-var">VAR</span> AVG_TikTok <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])
<span class="dax-var">VAR</span> AVG_Spotify <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])
<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(
        <span class="dax-fun">SUMX</span>(SubTable, (<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok) <span class="dax-operator">*</span> (<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify)),
        <span class="dax-fun">SQRT</span>(<span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok, <span class="dax-operator">2</span>)) <span class="dax-operator">*</span> <span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify, <span class="dax-operator">2</span>)))
    )</code></pre></div>

            <div class="code-container dax-block"><p><strong>10. Correlation Niche TikTok</strong></p><pre><code><span class="dax-measure">Correlation Niche TikTok</span> <span class="dax-operator">=</span> 
<span class="dax-var">VAR</span> SubTable <span class="dax-operator">=</span> <span class="dax-fun">FILTER</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Category] <span class="dax-operator">=</span> <span class="dax-string">"3. Niche (< 100k posts)"</span>)
<span class="dax-var">VAR</span> AVG_TikTok <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])
<span class="dax-var">VAR</span> AVG_Spotify <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])
<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(
        <span class="dax-fun">SUMX</span>(SubTable, (<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok) <span class="dax-operator">*</span> (<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify)),
        <span class="dax-fun">SQRT</span>(<span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok, <span class="dax-operator">2</span>)) <span class="dax-operator">*</span> <span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify, <span class="dax-operator">2</span>)))
    )</code></pre></div>

            <div class="code-container dax-block"><p><strong>11. Correlation Popular TikTok</strong></p><pre><code><span class="dax-measure">Correlation Popular TikTok</span> <span class="dax-operator">=</span> 
<span class="dax-var">VAR</span> SubTable <span class="dax-operator">=</span> <span class="dax-fun">FILTER</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Category] <span class="dax-operator">=</span> <span class="dax-string">"2. Popular (100k - 1M posts)"</span>)
<span class="dax-var">VAR</span> AVG_TikTok <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])
<span class="dax-var">VAR</span> AVG_Spotify <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])
<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(
        <span class="dax-fun">SUMX</span>(SubTable, (<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok) <span class="dax-operator">*</span> (<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify)),
        <span class="dax-fun">SQRT</span>(<span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok, <span class="dax-operator">2</span>)) <span class="dax-operator">*</span> <span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify, <span class="dax-operator">2</span>)))
    )</code></pre></div>

            <div class="code-container dax-block"><p><strong>12. Correlation Viral TikTok</strong></p><pre><code><span class="dax-measure">Correlation Viral TikTok</span> <span class="dax-operator">=</span> 
<span class="dax-var">VAR</span> SubTable <span class="dax-operator">=</span> <span class="dax-fun">FILTER</span>(<span class="dax-fun">ALL</span>(<span class="dax-table">'final Engagement_Ratio'</span>), <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Category] <span class="dax-operator">=</span> <span class="dax-string">"1. Viral (> 1M posts)"</span>)
<span class="dax-var">VAR</span> AVG_TikTok <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views])
<span class="dax-var">VAR</span> AVG_Spotify <span class="dax-operator">=</span> <span class="dax-fun">AVERAGEX</span>(SubTable, <span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams])
<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(
        <span class="dax-fun">SUMX</span>(SubTable, (<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok) <span class="dax-operator">*</span> (<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify)),
        <span class="dax-fun">SQRT</span>(<span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[TikTok_Views] <span class="dax-operator">-</span> AVG_TikTok, <span class="dax-operator">2</span>)) <span class="dax-fun">*</span> <span class="dax-fun">SUMX</span>(SubTable, <span class="dax-fun">POWER</span>(<span class="dax-table">'final Engagement_Ratio'</span>[Spotify_Streams] <span class="dax-operator">-</span> AVG_Spotify, <span class="dax-operator">2</span>)))
    )</code></pre></div>

            <span class="step-description">Statistical verification of the correlation (T-Test). The higher the t-value (above 1.96), the more statistically significant and reliable the examined relationship is.</span>
            <div class="code-container dax-block"><p><strong>13. T Statistic</strong></p><pre><code><span class="dax-measure">T Statistic</span> <span class="dax-operator">=</span> 
<span class="dax-var">VAR</span> r <span class="dax-operator">=</span> [Correlation No Outliers] <span class="sql-com">// correlation without outliers -> 0.25</span>
<span class="dax-var">VAR</span> n <span class="dax-operator">=</span> <span class="dax-fun">COUNTROWS</span>(<span class="dax-table">'final Engagement_Ratio'</span>) <span class="sql-com">// number of songs</span>
<span class="dax-var">RETURN</span>
    <span class="dax-fun">DIVIDE</span>(
        r <span class="dax-operator">*</span> <span class="dax-fun">SQRT</span>(n <span class="dax-operator">-</span> 2),
        <span class="dax-fun">SQRT</span>(1 <span class="dax-operator">-</span> <span class="dax-fun">POWER</span>(r, 2))
    )</code></pre></div>`,
          
          pbiContent: `
            <div class="report-structure">
              <div class="report-card">
                <h4>
                  <svg width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M3 13h8V3H3v10zm0 8h8v-6H3v6zm10 0h8V11h-8v10zm0-18v6h8V3h-8z"></path></svg>
                  1. Main Page (Scatter Plot & Drill-Through)
