---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Navbar from '../../components/Navbar.astro';
import Footer from '../../components/Footer.astro';
---

<BaseLayout title="Projekt: Analytical Sales Dashboard | Portfolio Jakub Nicpoń">
    <Navbar />

    <main>
        <header class="project-hero">
            <div class="container">
                <div class="hero-grid">
                    <div class="hero-content">
                        <h1>Analytical Sales Dashboard</h1>
                        <div class="section-underline"></div>
                        <p data-translate="heroDesc">Ten projekt to kompleksowa analiza 1,000 transakcji sprzedaży, której celem było przekształcenie surowych danych w strategiczne wnioski dotyczące rentowności i efektywności operacyjnej. W ramach badania poddałem analizie relację między całkowitym przychodem a zyskiem netto, monitorując jednocześnie realizację celów sprzedażowych oraz wydajność poszczególnych przedstawicieli. Skupiłem się na identyfikacji kluczowych trendów, takich jak ewolucja popularności kategorii produktowych oraz skuteczność zróżnicowanych kampanii marketingowych i źródeł pozyskiwania leadów. Szczególną uwagę poświęciłem segmentacji klientów i kanałom dystrybucji, co pozwoliło na wykrycie istotnych anomalii, takich jak niska rentowność kanału hurtowego mimo wysokiego wolumenu sprzedaży. Całość została osadzona w kontekście geograficznym i czasowym, co umożliwiło precyzyjne wskazanie czynników budujących wzrost wartości koszyka zakupowego w badanych latach.</p>
            
                        <a href="#project-details-card" class="scroll-down-link">
                            <span class="mouse-icon">
                               <span class="wheel"></span>
                            </span>
                            <span data-translate="btnDetails">Zobacz szczegóły</span>
                         </a>
                    </div>
                    <div class="hero-image-wrapper">
                        <img src="/assets/Project1.png" alt="Dashboard projektu Analytical Sales Dashboard" class="project-image" loading="eager" />
                    </div>
                </div>
            </div>
        </header>
        
        <section class="project-highlights">
            <div class="container">
                <h2 data-translate="kpiTitle">Kluczowe Wskaźniki</h2>
                <div class="section-underline centered-underline"></div>
                <div class="kpi-grid">
                    <div class="kpi-card"><span class="kpi-value">$5.24M</span><span class="kpi-label" data-translate="kpi1Label">Całkowity Przychód</span></div>
                    <div class="kpi-card"><span class="kpi-value">$1.77M</span><span class="kpi-label" data-translate="kpi2Label">Zysk Netto</span></div>
                    <div class="kpi-card"><span class="kpi-value">10,225</span><span class="kpi-label" data-translate="kpi3Label">Sprzedane Jednostki</span></div>
                    <div class="kpi-card"><span class="kpi-value">~66%</span><span class="kpi-label" data-translate="kpi4Label">Średnia Realizacja Celu</span></div>
                </div>
            </div>
        </section>
        
        <section class="project-details">
            <div class="container">
                <h2 data-translate="detailsTitle">Szczegóły Projektu</h2>
                <div class="section-underline centered-underline"></div>
                
                <div class="details-card" id="project-details-card">
    
                    <div class="toggle-buttons">
                        <button class="toggle-btn is-active" onclick="showSection('sectionColumns')" data-translate="tabColumns">Opis Kolumn</button>
                        <button class="toggle-btn" onclick="showSection('sectionKPIs')" data-translate="tabKPIs">Kluczowe Wskaźniki</button>
                        <button class="toggle-btn" onclick="showSection('sectionAnalysis')" data-translate="tabAnalysis">Analiza</button>
                        <button class="toggle-btn" onclick="showSection('sectionMethodology')" data-translate="tabMethodology">Metodologia</button>
                    </div>
                    
                    <div id="info-sections-container">
                        <div id="sectionColumns" class="info-section active" role="region">
                            <table class="kpi-table">
                                <thead><tr><th data-translate="tableHeaderColumn">Kolumna</th><th data-translate="tableHeaderDesc">Opis</th></tr></thead>
                                <tbody id="columnsTableBody"></tbody>
                            </table>
                        </div>
    
                        <div id="sectionKPIs" class="info-section" role="region">
                             <table class="kpi-table">
                                 <thead><tr><th>KPI</th><th data-translate="tableHeaderResult">Wynik</th></tr></thead>
                                 <tbody id="kpisTableBody"></tbody>
                            </table>
                        </div>
    
                        <div id="sectionAnalysis" class="info-section" role="region">
                            <div class="analysis-grid">
                                <div class="analysis-table-container">
                                    <table class="kpi-table">
                                        <thead><tr><th data-translate="tableHeaderArea">Obszar Analizy</th><th data-translate="tableHeaderConclusions">Wnioski</th></tr></thead>
                                        <tbody id="analysisTableBody"></tbody>
                                    </table>
                                </div>
                                <div class="analysis-conclusions">
                                    <ol id="analysisListBody"></ol>
                                </div>
                            </div>
                        </div>
    
                        <div id="sectionMethodology" class="info-section" role="region">
                            <table class="kpi-table">
                                <thead><tr><th data-translate="tableHeaderStep">Krok Procesu</th><th data-translate="tableHeaderDesc">Opis</th></tr></thead>
                                <tbody id="methodologyTableBody"></tbody>
                            </table>
                        </div>
                    </div>
                </div>
            </div>
        </section>
    
        <section class="project-files">
            <div class="container">
                <h2 data-translate="downloadTitle">Pobierz Zasoby Projektu</h2>
                <div class="section-underline centered-underline"></div>
                <div class="files-container">
                    <a href="/assets/Project1.png" download class="gradient__border__container"><span class="gradient__border__text" data-translate="btnDownloadDashboard">Pobierz Dashboard (PNG)</span></a>
                    <a href="/assets/P1 Analytical Sales Dashboard.xlsx" download class="gradient__border__container"><span class="gradient__border__text" data-translate="btnDownloadExcel">Pobierz Plik Excel</span></a>
                </div>
            </div>
        </section>
    </main>

    <Footer />

    <style is:global>
    .container { max-width: 1200px; margin: 0 auto; padding: 0 20px; position: relative; z-index: 1;}
    .section-underline { margin: 20px 0 30px 0; width: 80px; height: 4px; border-radius: 2px; background: var(--line-gradient); }
    .centered-underline { margin: 20px auto 30px auto; }
    
    .project-hero { padding: 140px 0 80px; position: relative; overflow: hidden; z-index: 1;}
    .hero-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 60px; align-items: center; }
    .hero-content h1 { font-size: 3.8rem; font-weight: 800; line-height: 1.1; margin-bottom: 0; color: var(--text-primary); }
    .hero-content p { font-size: 1.2rem; color: var(--text-secondary); max-width: 500px; }
    .hero-image-wrapper { perspective: 1000px; }
    .project-image { display: block; width: 100%; height: auto; border-radius: 16px; box-shadow: var(--card-shadow); cursor: pointer; border: 1px solid var(--border-color); transition: transform 0.3s ease, border-color 0.3s ease; }
    .project-image:hover { transform: scale(1.05) rotateY(-5deg) rotateX(5deg); border-color: var(--cyan); }
    .project-gallery-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 15px; }
    .project-gallery-grid .project-image:nth-child(3) { grid-column: span 2; }
    
    .scroll-down-link { display: inline-flex; align-items: center; gap: 12px; margin-top: 40px; color: var(--text-secondary); font-weight: 600; text-decoration: none; cursor: pointer; transition: color 0.3s ease, transform 0.3s ease; }
    .scroll-down-link:hover { color: var(--cyan); transform: translateY(-3px); }
    .mouse-icon { width: 24px; height: 40px; border: 2px solid var(--text-secondary); border-radius: 20px; position: relative; transition: border-color 0.3s ease; }
    .scroll-down-link:hover .mouse-icon { border-color: var(--cyan); }
    .mouse-icon .wheel { display: block; width: 4px; height: 8px; background-color: var(--cyan); border-radius: 2px; position: absolute; top: 8px; left: 50%; transform: translateX(-50%); animation: scroll-wheel-anim 2s infinite ease-in-out; }
    @keyframes scroll-wheel-anim { 0% { transform: translate(-50%, 0); opacity: 1; } 50% { transform: translate(-50%, 10px); opacity: 1; } 100% { transform: translate(-50%, 20px); opacity: 0; } }

    .project-highlights { padding: 80px 0; z-index: 1; position: relative;}
    .project-highlights h2, .project-details h2, .project-files h2 { text-align: center; font-size: 2.5rem; font-weight: 700; background: var(--line-gradient); -webkit-background-clip: text; -webkit-text-fill-color: transparent; }
    .kpi-grid { display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 30px; margin-top: 50px; justify-content: center; }
    
    .kpi-card { background: var(--bg-surface); border: 1px solid var(--border-color); border-radius: 15px; padding: 30px; text-align: center; position: relative; overflow: visible; backdrop-filter: blur(10px); transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease; }
    .kpi-card::before { content: ''; position: absolute; top: 0; left: 0; width: 100%; height: 100%; background: radial-gradient(circle at var(--mouse-x) var(--mouse-y), var(--spotlight-color), transparent 50%); opacity: 0; transition: opacity 0.3s; border-radius: 15px; pointer-events: none; z-index: 0; }
    .kpi-card > * { position: relative; z-index: 1; }
    .kpi-card:hover { transform: translateY(-8px) scale(1.03); border-color: var(--cyan); box-shadow: var(--card-shadow); }
    .kpi-card:hover::before { opacity: 1; }
    
    .kpi-value { display: block; font-size: 2.2rem; font-weight: 700; color: var(--text-primary); margin-bottom: 8px; }
    .kpi-label { font-size: 1rem; color: var(--text-secondary); }
    
    .project-details { padding: 80px 0; z-index: 1; position: relative;}
    .details-card { background: var(--bg-surface); padding: 40px; border-radius: 16px; border: 1px solid var(--border-color); backdrop-filter: blur(12px); -webkit-backdrop-filter: blur(12px); box-shadow: var(--card-shadow); transition: background-color var(--transition-speed) ease, border-color var(--transition-speed) ease; }
    .toggle-buttons { display: flex; justify-content: center; flex-wrap: wrap; gap: 15px; margin-bottom: 40px; }
    .toggle-btn { appearance: none; background: var(--btn-bg); border: 1px solid var(--border-color); color: var(--text-secondary); font-weight: 600; font-family: 'Inter', sans-serif; font-size: 1rem; padding: 12px 24px; border-radius: 12px; cursor: pointer; transition: all 0.3s ease;}
    .toggle-btn:hover { color: var(--text-primary); border-color: var(--cyan); transform: translateY(-2px); }
    .toggle-btn.is-active { background: var(--line-gradient); color: white; border-color: transparent; transform: scale(1.05); box-shadow: 0 5px 15px var(--spotlight-color); }
    .info-section { display: none; margin-top: 20px; padding-top: 30px; border-top: 1px solid var(--border-color); }
    .info-section.active { display: block; animation: fadeIn .4s ease; }
    @keyframes fadeIn { from { opacity: 0; transform: translateY(10px); } to { opacity: 1; transform: translateY(0); } }
    
    .kpi-table { width: 100%; border-collapse: collapse; table-layout: fixed; }
    .kpi-table th, .kpi-table td { padding: 14px 10px; border-bottom: 1px solid var(--border-color); text-align: center; width: 50%; }
    .kpi-table tr:last-child td { border-bottom: none; }
    .kpi-table thead th { font-weight: 700; color: var(--text-primary); text-transform: uppercase; letter-spacing: 0.5px; }
    .kpi-table td { color: var(--text-secondary); }
    
    .analysis-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 40px; align-items: start; }
    .analysis-conclusions ol { list-style: none; padding-left: 0; counter-reset: conclusion-counter; }
    .analysis-conclusions li { position: relative; padding-left: 45px; margin-bottom: 25px; }
    .analysis-conclusions li::before { counter-increment: conclusion-counter; content: counter(conclusion-counter); position: absolute; left: 0; top: -2px; width: 30px; height: 30px; border-radius: 50%; background: var(--line-gradient); color: white; font-weight: 700; font-size: 1rem; display: flex; align-items: center; justify-content: center; }
    .analysis-conclusions strong { display: block; margin-bottom: 5px; color: var(--text-primary); font-size: 1.1rem; }
    .analysis-conclusions p { color: var(--text-secondary); font-size: 0.95rem; margin: 0; }

    .project-files { padding: 20px 0; z-index: 1; position: relative;}
    .files-container { display: flex; justify-content: center; gap: 20px; flex-wrap: wrap; margin-top: 50px; }
    .gradient__border__container { display: inline-block; position: relative; padding: 1px; border-radius: 30px; background: var(--line-gradient); background-size: 200% 200%; animation: spin-gradient 6s linear infinite; cursor: pointer; transition: transform 0.2s, box-shadow 0.2s; min-width: 150px; text-align: center; text-decoration: none; box-shadow: 0 4px 20px var(--spotlight-color); }
    .gradient__border__container:hover { transform: translateY(-2px); box-shadow: 0 8px 30px var(--spotlight-color); }
    .gradient__border__container .gradient__border__text { display: block; background: var(--bg-surface); border-radius: 29px; padding: 0.8rem 2rem; font-size: 1rem; font-weight: 600; color: var(--text-primary); transition: background 0.3s, color 0.3s; }
    .gradient__border__container:hover .gradient__border__text { background: transparent; color: #fff;}
    @keyframes spin-gradient { 0% { background-position: 0% 50%; } 50% { background-position: 100% 50%; } 100% { background-position: 0% 50%; } }
    
    @media (max-width: 900px) { 
        .hero-grid { grid-template-columns: 1fr; gap: 40px; text-align: center; } 
        .hero-content { order: 2; } 
        .hero-image-wrapper { order: 1; } 
        .hero-content .section-underline, .hero-content .scroll-down-link { margin-left: auto; margin-right: auto; } 
        .analysis-grid { grid-template-columns: 1fr; gap: 30px; }
    }
    @media (max-width: 600px) { 
        .hero-content h1 { font-size: 2.8rem; } 
        .project-highlights h2, .project-details h2, .project-files h2 { font-size: 2rem; } 
        .details-card { padding: 25px; } 
    }
</style>

    <script is:inline>
        // === TŁUMACZENIA SPECYFICZNE DLA TEGO PROJEKTU ===
        const translations = {
            pl: {
                pageTitle: "Projekt: Analytical Sales Dashboard | Portfolio Jakub Nicpoń",
                heroDesc: "Projekt stanowi kompleksową analizę 1000 transakcji, przekształcającą dane w strategiczne wnioski na temat rentowności, wydajności sprzedaży oraz skuteczności kampanii marketingowych. Skupia się na wykrywaniu anomalii biznesowych, takich jak niska marża w kanale hurtowym, oraz badaniu trendów produktowych budujących wzrost wartości koszyka. Dzięki osadzeniu danych w kontekście geograficznym i czasowym, dostarcza precyzyjnych rozwiązań optymalizujących strategię biznesową.",
