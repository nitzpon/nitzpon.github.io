                    <tr><td>Flag</td><td>Adres URL flagi kraju</td></tr>

                    <tr class="table-separator"><td colspan="2">dimChannel</td></tr>
                    <tr><td>Channel_ID</td><td>Identyfikator kanału sprzedaży</td></tr>
                    <tr><td>Channel</td><td>Kanał sprzedaży</td></tr>
                `,
                kpisData: `
                    <tr><td>Całkowity przychód</td><td>$1 128 104 547</td></tr>
                    <tr><td>Liczba sprzedanych pojazdów</td><td>15 002</td></tr>
                    <tr><td>Średnia cena sprzedaży</td><td>$75 196</td></tr>
                    <tr><td>Sprzedane samochody elektryczne (BMW I)</td><td>2 960 (19,7% ogółem) (śr. cena $74,65 tys.)</td></tr>
                    <tr><td>Sprzedane samochody M (M2, M3, M4, M5, M8)</td><td>2 720 (18,1% ogółem) (śr. cena $76,64 tys.)</td></tr>
                    <tr><td>Kraj o największej ilości sprzedaży</td><td>Stany Zjednoczone - 1019 egzemplarzy</td></tr>
                    <tr><td>Kraj o najmniejszej ilości sprzedaży</td><td>Włochy - 515 egzemplarzy</td></tr>
                    <tr><td>Najwyższy przychód wg. kraju sprzedaży</td><td>Meksyk - $76 809 376</td></tr>
                    <tr><td>Najniższy przychód wg. kraju sprzedaży</td><td>Włochy - $37 339 854</td></tr>
