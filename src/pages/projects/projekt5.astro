                                    <pre><code><span class="dax-measure">Revenue change %</span> <span class="dax-operator">=</span> 
<span class="dax-keyword">VAR</span> arrowDirection <span class="dax-operator">=</span> [Revenue] <span class="dax-operator">-</span> [Revenue PY]
