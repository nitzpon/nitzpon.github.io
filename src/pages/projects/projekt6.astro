                    <tr><td>Discharge Date</td><td>Data wypisu ze szpitala</td></tr>
                    <tr><td>Medication</td><td>Przyjmowane leki</td></tr>
                    <tr><td>Test Results</td><td>Wyniki badań</td></tr>
                    <tr><td>Hospital Latitude</td><td>Szerokość geograficzna szpitala</td></tr>
                    <tr><td>Hospital Longitude</td><td>Długość geograficzna szpitala</td></tr>
                `,
                kpisData: `
                    <tr><td>Całkowita liczba pacjentów</td><td>55 500</td></tr>
                    <tr><td>Średni wiek pacjenta</td><td>52 lata</td></tr>
                    <tr><td>Najstarszy i najmłodszy pacjent</td><td>89 / 13 lat</td></tr>
                    <tr><td>Najliczniejsza grupa wiekowa pacjentów</td><td>56-65 lat</td></tr>
                    <tr><td>Pacjenci wg. płci</td><td>50% - kobiety, 40% - mężczyźni, 10% - osoby niebinarne</td></tr>
                    <tr><td>Średnia długość pobytu</td><td>15,5 dnia</td></tr>
                    <tr><td>Najdłuższy pobyt</td><td>30 dni (1657 pacjentów)</td></tr>
                    <tr><td>Najczęściej występujące schorzenia</td><td>Cukrzyca / nadciśniecie ~ 13 875 przypadków</td></tr>
                    <tr><td>Najczęstszy stan podczas przyjęcia</td><td>Przyjęcie planowe 18 655</td></tr>
