        function applyLanguage(lang) {
            localStorage.setItem('preferredLanguage', lang);
            document.documentElement.lang = lang;
            
            document.querySelectorAll('[data-translate]').forEach(el => {
                const key = el.dataset.translate;
                if (translations[lang] && translations[lang][key]) { el.innerHTML = translations[lang][key]; }
            });
            document.querySelectorAll('[data-translate-alt]').forEach(el => {
                const key = el.dataset.translateAlt;
                if (translations[lang] && translations[lang][key]) { el.alt = translations[lang][key]; }
            });
            document.querySelectorAll('[data-translate-title]').forEach(el => {
                const key = el.dataset.translateTitle;
                if (translations[lang] && translations[lang][key]) { el.title = translations[lang][key]; }
            });

            // Aktywacja przycisków globalnie
            document.querySelectorAll('.lang-btn').forEach(btn => {
                btn.classList.toggle('active', btn.dataset.lang === lang);
            });
        }

        document.addEventListener('DOMContentLoaded', () => {
            const currentLang = localStorage.getItem('preferredLanguage') || 'pl';
            applyLanguage(currentLang);

            document.querySelectorAll('.lang-btn').forEach(button => {
                button.addEventListener('click', (e) => {
                    applyLanguage(e.target.dataset.lang);
                    document.body.classList.remove('nav-open'); // Zamyka menu mobilne
                });
            });
        });
    </script>

    <!-- GLOBALNE SKRYPTY PRZEWIJANIA -->
    <script is:inline>
        function initGlobalScripts() {
            window.lenis = new Lenis({
                duration: 1.5,
                easing: (t) => Math.min(1, 1.001 - Math.pow(2, -10 * t)),
                direction: 'vertical',
                smooth: true,
                smoothTouch: false,
                touchMultiplier: 2,
            });

            function raf(time) {
                window.lenis.raf(time);
                requestAnimationFrame(raf);
            }
            requestAnimationFrame(raf);

            window.lenis.on('scroll', ({ scroll }) => {
                sessionStorage.setItem('scroll_pos_' + window.location.pathname, scroll);
            });

            const isBackNav = window.performance && 
                window.performance.getEntriesByType('navigation')[0] && 
                window.performance.getEntriesByType('navigation')[0].type === 'back_forward';
            
            const savedScroll = sessionStorage.getItem('scroll_pos_' + window.location.pathname);

            if (isBackNav && savedScroll !== null) {
                window.lenis.scrollTo(parseFloat(savedScroll), { immediate: true });
            } else if (window.location.hash) {
                const target = document.querySelector(window.location.hash);
                if (target) {
                    window.lenis.scrollTo(target, { immediate: true, offset: -70 });
                }
            }

            requestAnimationFrame(() => {
                document.documentElement.classList.remove('hash-loading');
            });

            const scrollProgress = document.getElementById('scroll-progress');
            window.lenis.on('scroll', ({ scroll, limit }) => {
                if (scrollProgress && limit > 0) {
                    const progress = (scroll / limit) * 100;
                    scrollProgress.style.width = `${progress}%`;
                }
            });

            // Lightbox globalny
            const lightbox = document.getElementById('lightbox');
            if (lightbox) {
                const lightboxImg = document.getElementById('lightbox-img');
                const lightboxClose = document.querySelector('.lightbox-close');
                
                window.openLightbox = (src) => {
                    lightboxImg.setAttribute('src', src);
                    lightbox.classList.add('active');
                    document.body.classList.add('lightbox-open');
                    window.lenis.stop();
                };

                window.closeLightbox = () => {
                    lightbox.classList.remove('active');
                    document.body.classList.remove('lightbox-open');
                    window.lenis.start();
                };

                if (lightboxClose) lightboxClose.addEventListener('click', window.closeLightbox);
                lightbox.addEventListener('click', (e) => { if (e.target === lightbox) window.closeLightbox(); });
                document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && lightbox.classList.contains('active')) window.closeLightbox(); });
            }
        }

        document.addEventListener('DOMContentLoaded', initGlobalScripts);
    </script>
</body>
