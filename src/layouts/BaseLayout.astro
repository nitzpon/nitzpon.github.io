---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="pl">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title data-translate="pageTitle">{title}</title>
    <link rel="icon" href="/assets/favicon.png">
    
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700;800;900&display=swap" rel="stylesheet">
    
    <script src="https://unpkg.com/@studio-freight/lenis@1.0.42/dist/lenis.min.js"></script>

    <!-- KRYTYCZNY SKRYPT PRZED RENDEROWANIEM STRONY -->
    <script is:inline>
        const savedTheme = localStorage.getItem('theme') || 'light';
        document.documentElement.setAttribute('data-theme', savedTheme);

        if ('scrollRestoration' in history) {
            history.scrollRestoration = 'manual';
        }

        const isBackNav = window.performance && 
            window.performance.getEntriesByType('navigation')[0] && 
            window.performance.getEntriesByType('navigation')[0].type === 'back_forward';

        if (window.location.hash || isBackNav) {
            document.documentElement.classList.add('hash-loading');
            setTimeout(() => {
                document.documentElement.classList.remove('hash-loading');
            }, 500);
        }
    </script>

    <style is:global>
        /* === GLOBALNE USTAWIENIA I ZMIENNE MOTYWÓW === */
        :root {
            --header-blur: 0px;
            --header-opacity: 1;
            --transition-speed: 0.4s;
            
            /* CIEMNY MOTYW: MIDNIGHT NAVY */
            --bg-dark: #070d18;
            --bg-surface: #0e1726;
            --bg-nav: rgba(7, 13, 24, 0.88);
            --header-card-bg: rgba(14, 23, 38, 0.7);
            --header-fade: #070d18;
            --hover-bg: rgba(20, 32, 50, 0.85);
            
            --text-primary: #f8fafc;
            --text-secondary: #94a3b8;
            
            --cyan: #06b6d4;
            --indigo: #6366f1;
            --purple: rgba(168, 85, 247, 0.15);
            
            --border-color: rgba(148, 163, 184, 0.12);
            --card-shadow: 0 15px 40px rgba(2, 6, 15, 0.6);
            --header-shadow: 0 30px 60px rgba(2, 6, 15, 0.6);
            --big-num-color: linear-gradient(135deg, var(--indigo), var(--cyan));
            --big-num-opacity: 0.12;
            --btn-bg: rgba(255, 255, 255, 0.05);
            --badge-bg: rgba(7, 13, 24, 0.85);
            
            --line-gradient: linear-gradient(90deg, var(--indigo), var(--cyan));
            --spotlight-color: rgba(99, 102, 241, 0.18);
            
            --orb-1-color: var(--indigo);
            --orb-2-color: var(--cyan);
            --orb-3-color: var(--purple);
            --orb-opacity: 0.2;

            --scroll-arrow-color: var(--text-secondary);
            --code-bg: #0b1320;
        }

        /* JASNY MOTYW: REKRUTACYJNY / PREMIUM LIGHT (SLATE & PURE WHITE) */
        [data-theme="light"] {
            --bg-dark: #f8fafc;
            --bg-surface: #ffffff; 
            --bg-nav: rgba(255, 255, 255, 0.88);
            --header-card-bg: #ffffff;
            --header-fade: #f8fafc;
            --hover-bg: #f1f5f9;
            
            --text-primary: #0f172a;        
            --text-secondary: #475569;      
            
            --cyan: #0284c7;                
            --indigo: #4f46e5;              
            --purple: rgba(168, 85, 247, 0.1);
            
            --border-color: rgba(226, 232, 240, 0.9); 
            --card-shadow: 0 12px 32px -10px rgba(15, 23, 42, 0.08), 0 4px 6px -2px rgba(15, 23, 42, 0.03);
            --header-shadow: 0 20px 45px -15px rgba(15, 23, 42, 0.1);
            --big-num-color: linear-gradient(135deg, var(--indigo), var(--cyan));
            --big-num-opacity: 0.07; 
            --btn-bg: #f8fafc;
            --badge-bg: rgba(255, 255, 255, 0.95);
            
            --line-gradient: linear-gradient(90deg, var(--indigo), var(--cyan));
            --spotlight-color: rgba(79, 70, 229, 0.06);
            
            --orb-1-color: rgba(192, 132, 252, 0.45);
            --orb-2-color: rgba(56, 189, 248, 0.5);
            --orb-3-color: transparent; 
            --orb-opacity: 0.22; 

            --scroll-arrow-color: var(--indigo);
            --code-bg: #0f172a;             
        }

        html.hash-loading body { opacity: 0 !important; }
        ::-webkit-scrollbar { width: 10px; }
        ::-webkit-scrollbar-track { background: var(--bg-dark); }
        ::-webkit-scrollbar-thumb { background: var(--border-color); border-radius: 5px; border: 2px solid var(--bg-dark); }
        ::-webkit-scrollbar-thumb:hover { background: var(--indigo); }

        .scroll-progress-container { position: fixed; top: 0; left: 0; width: 100%; height: 3px; z-index: 1002; background: transparent; }
        .scroll-progress-bar { height: 100%; width: 0%; background: var(--line-gradient); border-radius: 0 2px 2px 0; transition: width 0.1s ease-out; box-shadow: 0 0 10px var(--cyan); }

        .ambient-background { position: fixed; top: 0; left: 0; width: 100vw; height: 100vh; z-index: -2; overflow: hidden; background: var(--bg-dark); transition: background-color var(--transition-speed) ease;}
        .ambient-orb { position: absolute; border-radius: 50%; filter: blur(100px); opacity: var(--orb-opacity); animation: floatOrb 20s infinite alternate cubic-bezier(0.4, 0, 0.2, 1); transition: opacity var(--transition-speed) ease, background var(--transition-speed) ease; will-change: transform, opacity;}
        
        .orb-1 { top: -10%; right: -10%; left: auto; width: 60vw; height: 60vw; background: radial-gradient(circle, var(--orb-1-color), transparent 60%); animation-duration: 25s; }
        .orb-2 { bottom: -10%; left: -10%; right: auto; width: 70vw; height: 70vw; background: radial-gradient(circle, var(--orb-2-color), transparent 60%); animation-duration: 32s; animation-direction: alternate-reverse; }
        .orb-3 { top: 30%; left: 40%; width: 40vw; height: 40vw; background: radial-gradient(circle, var(--orb-3-color), transparent 60%); animation-duration: 28s; animation-delay: -5s; }

        @keyframes floatOrb { 0% { transform: translate(0, 0) scale(1); } 100% { transform: translate(40px, 20px) scale(1.05); } }

        * { margin: 0; padding: 0; box-sizing: border-box; }
        
        html.lenis { height: auto; }
        .lenis.lenis-smooth { scroll-behavior: auto; }
        .lenis.lenis-smooth [data-lenis-prevent] { overscroll-behavior: contain; }
        .lenis.lenis-stopped { overflow: hidden; }
        .lenis.lenis-scrolling iframe { pointer-events: none; }
        
        body { font-family: 'Inter', sans-serif; line-height: 1.6; color: var(--text-primary); background-color: transparent; overflow-x: hidden; position: relative; transition: background-color var(--transition-speed) ease, color var(--transition-speed) ease, opacity 0.2s ease; }
        body.nav-open, body.lightbox-open { overflow: hidden; }
        
        /* Lightbox */
        .lightbox { position: fixed; z-index: 2000; top: 0; left: 0; width: 100%; height: 100%; background-color: rgba(7, 13, 24, 0.95); backdrop-filter: blur(10px); display: flex; justify-content: center; align-items: center; opacity: 0; pointer-events: none; transition: opacity 0.3s ease; }
        .lightbox.active { opacity: 1; pointer-events: auto; }
        .lightbox-content { max-width: 90%; max-height: 85%; border-radius: 6px; box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.7); transform: scale(0.95); transition: transform 0.3s cubic-bezier(0.175, 0.885, 0.32, 1.275); }
        .lightbox.active .lightbox-content { transform: scale(1); }
        .lightbox-close { position: absolute; top: 20px; right: 30px; color: #fff; font-size: 35px; font-weight: 300; cursor: pointer; transition: color 0.2s, transform 0.2s; user-select: none; z-index: 2001; }
        .lightbox-close:hover { color: var(--cyan); transform: scale(1.1); }
    </style>
</head>
<body>

    <div class="ambient-background">
        <div class="ambient-orb orb-1"></div>
        <div class="ambient-orb orb-2"></div>
        <div class="ambient-orb orb-3"></div>
    </div>

    <div class="scroll-progress-container">
        <div class="scroll-progress-bar" id="scroll-progress"></div>
    </div>

    <slot />

    <div id="lightbox" class="lightbox">
        <span class="lightbox-close">&times;</span>
        <img class="lightbox-content" id="lightbox-img">
    </div>

